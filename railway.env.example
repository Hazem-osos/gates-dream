# Copy these into Railway Variables. Do not commit real secrets.
# Name the services exactly: gates-backend, gates-web
# Add a MySQL plugin and attach it to gates-backend.

# ── gates-backend ──────────────────────────────────────────────
NODE_ENV=production
API_AUTH_MODE=enforce
KEYCLOAK_ENABLED=false
REDIS_ENABLED=false
MQTT_ENABLED=false
CORS_ALLOW_RAILWAY=true
# Attach MySQL, then:
# DATABASE_URL=${{MySQL.MYSQL_URL}}
FRONTEND_URL=https://${{gates-web.RAILWAY_PUBLIC_DOMAIN}}
# Generate two long random strings (32+ chars). JWT_DEV_SECRET is required for password login.
JWT_DEV_SECRET=
ENCRYPTION_KEY=
# First deploy only — creates owner@example.com
SEED_ON_BOOT=true
ALLOW_PROD_SEED=true
SEED_OWNER_PASSWORD=

# ── gates-web ──────────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_AUTH_MODE=enforce
NEXT_PUBLIC_AUTH_LOGIN_PATH=/auth/login
NEXT_PUBLIC_AUTH_REGISTER_PATH=/auth/register
# Leave NEXT_PUBLIC_API_URL unset so the browser talks same-origin /api/v1.
# Mark BACKEND_PROXY_TARGET as available at build time in Railway.
BACKEND_PROXY_TARGET=http://${{gates-backend.RAILWAY_PRIVATE_DOMAIN}}:${{gates-backend.PORT}}
BACKEND_INTERNAL_URL=http://${{gates-backend.RAILWAY_PRIVATE_DOMAIN}}:${{gates-backend.PORT}}
