apiVersion: v1
kind: Secret
metadata:
  name: gates-secrets
type: Opaque
stringData:
  database-url: "postgresql://user:password@postgres:5432/gates_erp"
  redis-url: "redis://redis:6379"
  keycloak-server-url: "https://keycloak.example.com"
  keycloak-realm: "gates-erp"
  keycloak-client-id: "gates-backend"
  keycloak-client-secret: "your-secret-here"

