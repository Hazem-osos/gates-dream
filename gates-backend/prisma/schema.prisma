  hijriDate      String?
  description    String?   @db.Text
  receiptType    String // 'cash' | 'bank' | 'safe' | 'party'
  // Source (where money comes from)
  customerId     String?
  supplierId     String?
  accountId      String?
  // Destination (where money goes)
  safeId         String?
  bankAccountId  String?
  // Amounts
  amount         Decimal   @db.Decimal(15, 2)
  currencyCode   String
  exchangeRate   Decimal?  @db.Decimal(15, 6)
  // Status
  isPosted       Boolean   @default(false)
  postedAt       DateTime?
  isApproved     Boolean   @default(false)
  approvedAt     DateTime?
  isCancelled    Boolean   @default(false)
  cancelledAt    DateTime?
  // Journal Entry link
  journalEntryId String?
  fiscalYearId   String?
  sourceYearId   String?   @db.VarChar(20)
  postedBy       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYear      FiscalYear?      @relation(fields: [fiscalYearId], references: [id], onDelete: SetNull)
  customer        Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier        Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  account         Account?         @relation(fields: [accountId], references: [id], onDelete: SetNull)
  safe            Safe?            @relation(fields: [safeId], references: [id], onDelete: SetNull)
  bankAccount     BankAccount?     @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  journalEntry    JournalEntry?    @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  cashTransaction CashTransaction?
  Bank            Bank?            @relation(fields: [bankId], references: [id])
  bankId          String?

  @@unique([companyId, voucherNumber])
  @@index([companyId, date])
  @@index([voucherNumber])
  @@index([receiptType])
  @@index([fiscalYearId])
  @@map("treasury_receipts")
}

// Treasury Payment Vouchers
model TreasuryPayment {
