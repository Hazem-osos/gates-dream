// Company Settings
model CompanySettings {
  id                            String   @id @default(uuid())
  companyId                     String   @unique
  // General settings
  fiscalYearStart               String?
  fiscalYearEnd                 String?
  defaultCurrency               String?
  journalEntryDigits            Int?     @default(6)
  allowNegativeBalance          Boolean? @default(false)
  allowCostCenterWithoutAccount Boolean? @default(false)
  lockPostingBeforeDate         String?
  enableApprovalsWorkflow       Boolean? @default(true)
  autoNumbering                 Boolean? @default(true)
  decimalsInAmounts             Int?     @default(2)
  // Guide digits
  accountsGuideDigits           Int?
  costCentersGuideDigits        Int?
  storesGuideDigits             Int?
  itemsGuideDigits              Int?
  // Date settings
  dateUsage                     String? // 'gregorian' | 'hijri' | 'both'
  operationsFromDate            String?
  // Securities
  dueSecuritiesWarningDays      Int?
  // Budget settings
  budgetAllowExceed             Boolean? @default(false)
  budgetWarnHalf                Boolean? @default(false)
  budgetWarnSame                Boolean? @default(false)
  budgetWarnExceed              Boolean? @default(false)
  budgetStopMessageOnly         Boolean? @default(false)
  budgetStopLedger              Boolean? @default(false)
  budgetStopOrigin              Boolean? @default(false)
  budgetStopBoth                Boolean? @default(false)
  // System settings
  backupPath                    String?
  costMethod                    String? // 'average' | 'fifo' | 'lifo'
  theme                         String? // 'light' | 'dark'
  temporaryReceipts             Boolean? @default(false)
  documentaryCredits            Boolean? @default(false)
  // Advanced settings (stored as JSON)
  advancedSettings              Json? // For flexible advanced settings
  logoUrl                       String?
  // Account definitions (stored as JSON for flexibility)
  accountDefinitions            Json?
  /// M22 — default retained earnings account for year-end close
  retainedEarningsAccountId     String?
  executiveWhatsAppPhone        String?  @db.VarChar(30)
  /// When true (default), document save/post writes a linked journal entry.
  autoPostGl                    Boolean  @default(true)
  /// أساس ضرب سعر الوحدة: كمية الوحدة المختارة أو كمية الوحدة الأساسية.
  pricingCalculationBasis       String   @default("SELECTED_UNIT_QTY") @db.VarChar(30)
  /// Accounting settings engine — company-wide posting guardrails.
  preventNegativeStock          Boolean  @default(true)
  preventCashOverdraft          Boolean  @default(true)
  enforceCostCenterForPnl       Boolean  @default(false)
  preventSellingBelowCost       Boolean  @default(false)
  /// Default rounding-difference posting account (leaf Account.id).
  roundingAccountId             String?
  /// Combined FX gain/loss fallback when separate gain/loss slots are empty.
  exchangeGainLossAccountId     String?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  company                 Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roundingAccount         Account? @relation("CompanySettingsRoundingAccount", fields: [roundingAccountId], references: [id], onDelete: SetNull)
  exchangeGainLossAccount Account? @relation("CompanySettingsExchangeAccount", fields: [exchangeGainLossAccountId], references: [id], onDelete: SetNull)

  @@index([roundingAccountId])
  @@index([exchangeGainLossAccountId])
  @@map("company_settings")
}

/// Legacy CompanySetting name/value pairs (SerialStart*, GLPost, SaveUnbalanced, …).
/// `branchId` NULL = company-wide row; non-null = a branch-scoped override
/// (legacy stores `CustomersAccount` this way — see untbranchvariables.pas).
/// MySQL unique indexes treat every NULL as distinct, so uniqueness of the
/// `branchId IS NULL` (company-wide) row per (companyId, name) is enforced by
/// the service layer (findFirst-then-create/update), not this DB constraint.
model CompanySettingEntry {
  id        String   @id @default(uuid())
  companyId String
  branchId  String?
  name      String   @db.VarChar(100)
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch  Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([companyId, branchId, name])
  @@index([companyId])
  @@map("company_setting_entries")
}

/// Legacy Year table — fiscal year open/close (YearId)
model FiscalYear {
  id                    String    @id @default(uuid())
  companyId             String
  legacyYearId          String    @db.VarChar(20)
  arabicName            String?
  englishName           String?
  startDate             DateTime
  endDate               DateTime
  /// Open | Close — blocks posting when Close (legacy GetPeriod)
  status                String    @default("Open") @db.VarChar(10)
  closedAt              DateTime?
  closedBy              String?
  closingJournalEntryId String?
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalPeriods       FiscalPeriod[]
  documentSequences   DocumentSequence[]
  journalEntries      JournalEntry[]
  invoices            Invoice[]
  treasuryReceipts    TreasuryReceipt[]
  treasuryPayments    TreasuryPayment[]
  cashTransactions    CashTransaction[]
  cheques             Cheque[]
  taxPeriods          TaxPeriod[]
  taxDeclarations     TaxDeclaration[]
  posShifts           PosShift[]
  lettersOfCredit     LetterOfCredit[]
  guaranteeLetters    GuaranteeLetter[]
  payrollRuns         PayrollRun[]
  productionOrders    ProductionOrder[]
  counterpartyOffsets CounterpartyOffset[]

  @@unique([companyId, legacyYearId])
  @@index([companyId, status])
  @@map("fiscal_years")
}

/// Sub-periods within a fiscal year (monthly / custom slices)
model FiscalPeriod {
  id           String   @id @default(uuid())
  companyId    String
  fiscalYearId String
  periodNumber Int
  name         String?
  startDate    DateTime
  endDate      DateTime
  isClosed     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  @@unique([fiscalYearId, periodNumber])
  @@index([companyId, startDate, endDate])
  @@map("fiscal_periods")
}

/// Document numbering (GLNum, CashNum, …) — 8-digit zero-padded legacy serials
model DocumentSequence {
  id           String   @id @default(uuid())
  companyId    String
  branchId     String?
  fiscalYearId String?
  /// GL, CashBP, InvoiceRI, …
  docType      String   @db.VarChar(30)
  /// C = continuous across years; Y = reset per fiscal year
  scope        String   @default("Y") @db.Char(1)
  lastNumber   Int      @default(0)
  padding      Int      @default(8)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch     Branch?     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear? @relation(fields: [fiscalYearId], references: [id], onDelete: SetNull)

  @@unique([companyId, branchId, fiscalYearId, docType])
  @@index([companyId, docType])
  @@map("document_sequences")
}

/// Legacy NewModule — user-defined document-type instances per base type
/// (BP, BR, KP, KR, RC, PC, TP, SI, PI, SR, PR, store types, …). Each row is
/// one additional instance of a base document type (e.g. a second sales
/// invoice module "SI02"). `fullCode` (baseType + moduleCode, e.g. "SI01")
/// is the module-suffix used by legacy per-module settings such as
/// SalesDaribaSI01 / AutoPostBP01 / PostTostoreSI02 / NotCreateGLSR01.
model NewModule {
  id          String   @id @default(uuid())
  companyId   String
  /// Legacy base document type code (SI, PI, BP, KP, …)
  baseType    String   @db.Char(2)
  /// Legacy NewModuleCode — 2-digit sequence per (companyId, baseType), starts at "01"
  moduleCode  String   @db.Char(2)
  /// baseType + moduleCode — the settings-engine module key
  fullCode    String   @db.VarChar(4)
  nameAr      String
  nameEn      String?
  menuNameAr  String
  menuNameEn  String?
  priceListId String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  priceList PriceList?       @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  stores    NewModuleStore[]
  invoices  Invoice[]

  @@unique([companyId, baseType, moduleCode])
  @@unique([companyId, fullCode])
  @@index([companyId, baseType])
  @@map("new_modules")
}

/// Legacy NewModuleStore — warehouses a given user-defined store/document
/// module is allowed to operate against.
model NewModuleStore {
  id          String   @id @default(uuid())
  companyId   String
  newModuleId String
  warehouseId String
  createdAt   DateTime @default(now())

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  newModule NewModule @relation(fields: [newModuleId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([newModuleId, warehouseId])
  @@index([companyId])
  @@map("new_module_stores")
}

/// Legacy OtherModulesRights — cross-module read permission: a voucher
/// module (`sanadModule`, e.g. "BP01") is permitted to read/pull records
/// from another module (`readModule`, e.g. "DK01"). Plain code strings,
/// same as legacy (no FK — the referenced module may belong to a different
/// base-type family than NewModule tracks natively, e.g. tax settlements).
model OtherModuleRight {
  id          String   @id @default(uuid())
  companyId   String
  sanadModule String   @db.VarChar(4)
  readModule  String   @db.VarChar(4)
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, sanadModule, readModule])
  @@index([companyId])
  @@map("other_module_rights")
}

model User {
  id                String   @id @default(uuid())
  companyId         String
  email             String   @unique
  username          String   @unique
  passwordHash      String
  firstName         String?
  lastName          String?
  phone             String?
  preferredLanguage String?  @default("ar")
  avatarUrl         String?  @db.Text
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company             Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchPermissions   UserBranchPermission[]
  groupMemberships    UserGroupMember[]
  permissions         UserPermission[]
  advancedPermissions UserAdvancedPermission[]
  systemNotifications SystemNotification[]
  approvedUnitResales UnitResaleTransfer[]
  aiConversations     AiConversation[]
  aiAuditLogs         AiAuditLog[]
  aiDocuments         AiDocument[]
  tourProgress        UserTourProgress[]

  @@map("users")
}

/// In-app notifications for tenant users (stock alerts, posting, credit limits, etc.)
model SystemNotification {
  id        String   @id @default(uuid())
  companyId String
  userId    String?
  title     String
  message   String   @db.Text
  type      String   @default("INFO") @db.VarChar(20)
  category  String?  @db.VarChar(40)
  linkUrl   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId, isRead, createdAt])
  @@index([companyId, createdAt])
  @@map("system_notifications")
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum NotificationCategory {
  FINANCIAL_LIQUIDITY
  PROFIT_ANOMALY
  CHEQUE_DUE
  TAX_COMPLIANCE
  STOCK_REORDER
  EXPIRING_BATCH
  SALES_AUDIT
  UNPOSTED_DRAFTS
}

/// RBAC-targeted Gates Intelligence alerts. `targetRoles` is a JSON string[] (MySQL has no scalar lists).
model AiNotification {
  id            String               @id @default(uuid())
  companyId     String
  userId        String?
  targetRoles   Json
  category      NotificationCategory
  severity      NotificationSeverity @default(INFO)
  titleAr       String               @db.VarChar(240)
  messageAr     String               @db.Text
  actionUrl     String?              @db.VarChar(300)
  actionLabelAr String?              @db.VarChar(120)
  metadata      Json?
  fingerprint   String?              @db.VarChar(160)
  isRead        Boolean              @default(false)
  readAt        DateTime?
  createdAt     DateTime             @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, isRead])
  @@index([companyId, fingerprint])
  @@map("ai_notifications")
}

// Branch Permissions (which users can access which branches)
model UserBranchPermission {
  id        String   @id @default(uuid())
  userId    String
  branchId  String
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
  @@index([companyId])
  @@map("user_branch_permissions")
}

// User Groups
model UserGroup {
  id                      String   @id @default(uuid())
  companyId               String
  code                    String? // passwordName
  arabicName              String
  password                String? // Group password (optional)
  priceList               String?
  hidePricesInInvoices    Boolean? @default(false)
  allowChangePaymentValue Boolean? @default(false)
  posManager              Boolean? @default(false)
  deactivate              Boolean? @default(false)
  studentAffairs          Boolean? @default(false)
  busManager              Boolean? @default(false)
  studentAccounts         Boolean? @default(false)
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  company Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
