}

// User Group Members (many-to-many relationship)
model UserGroupMember {
  id          String   @id @default(uuid())
  companyId   String
  userId      String
  userGroupId String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userGroup UserGroup @relation(fields: [userGroupId], references: [id], onDelete: Cascade)

  @@unique([userId, userGroupId])
  @@index([userId])
  @@index([userGroupId])
  @@index([companyId])
  @@map("user_group_members")
}

// User Permissions (Fine-Grained Access Control)
model UserPermission {
  id        String   @id @default(uuid())
  userId    String
  companyId String
  resource  String   @db.VarChar(100) // Limited length for MySQL key constraints
  action    String   @db.VarChar(50) // Limited length for MySQL key constraints
  module    String?  @db.VarChar(100) // Optional module filter, limited length
  branchId  String? // Optional branch filter
  allow     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resource, action, module, branchId])
  @@index([userId])
  @@index([companyId])
  @@index([resource, action])
  @@index([module])
  @@index([branchId])
  @@map("user_permissions")
}

// User Advanced Permissions (Transfer/Untransfer operations)
model UserAdvancedPermission {
  id          String   @id @default(uuid())
  userId      String
  companyId   String
  branchId    String? // Optional branch-specific permissions
  permissions Json // Flexible JSON for transfer/untransfer permissions
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@index([branchId])
  @@map("user_advanced_permissions")
}

