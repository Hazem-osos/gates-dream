}

/// دفتر حصر الأعمال المنفذة (الأبعاد والخصومات والكميات الصافية).
model ExecutiveMeasurementSheet {
  id                 String                 @id @default(uuid())
  companyId          String
  projectId          String
  projectBOQItemId   String
  sheetNumber        String
  measurementDate    DateTime
  locationZone       String?
  axisGridRef        String?
  statement          String?                @db.Text
  multiplierCount    Decimal                @default(1) @db.Decimal(18, 4)
  dimensionLength    Decimal?               @db.Decimal(18, 4)
  dimensionWidth     Decimal?               @db.Decimal(18, 4)
  dimensionHeight    Decimal?               @db.Decimal(18, 4)
  calculatedGrossQty Decimal                @default(0) @db.Decimal(18, 4)
  deductionQty       Decimal                @default(0) @db.Decimal(18, 4)
  netExecutedQty     Decimal                @default(0) @db.Decimal(18, 4)
