// Wave 0 M4 — Moving average cost (legacy ItemCost)
model ItemCostHistory {
  id           String   @id @default(uuid())
  companyId    String
  branchId     String
  itemId       String
  serial       Int
  cost         Decimal  @db.Decimal(18, 4)
  effectiveAt  DateTime
  documentDate DateTime
  hijriDate    String?
  sourceType   String   @db.VarChar(30)
  sourceNumber String   @db.VarChar(30)
  sourceYearId String   @db.VarChar(20)
  createdAt    DateTime @default(now())

  // H14 fix: the moving-average cost trail is financial history — never
  // let a company/branch/item hard-delete silently wipe it out.
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  item    Item    @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([companyId, itemId, serial])
  @@unique([companyId, itemId, sourceType, sourceNumber, sourceYearId])
  @@index([companyId, itemId, effectiveAt])
  @@map("item_cost_history")
}

/// Consolidated stock ledger (legacy AllWarehousingTrans)
model InventoryMovement {
  id            String   @id @default(uuid())
  companyId     String
  branchId      String?
  warehouseId   String
  itemId        String
  locationId    String?
  quantityDelta          Decimal  @db.Decimal(18, 4)
  unitCost               Decimal? @db.Decimal(18, 4)
  resultingAverageCost   Decimal? @db.Decimal(18, 4)
  movementType           String   @db.VarChar(30)
  sourceType             String?  @db.VarChar(30)
  sourceNumber           String?  @db.VarChar(30)
  sourceYearId           String?  @db.VarChar(20)
  sourceDocumentId       String?  @db.VarChar(80)
  documentDate           DateTime
  effectiveAt            DateTime @default(now())
  createdAt              DateTime @default(now())

  // H14 fix: stock ledger history is financial history — never let a
  // company/warehouse/item hard-delete silently wipe out inventory movements.
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch    Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  location  Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([companyId, itemId, effectiveAt])
  @@index([companyId, warehouseId, itemId])
  @@index([companyId, warehouseId, itemId, documentDate])
  @@index([companyId, documentDate(sort: Desc), movementType], map: "idx_inventory_movements_date_type")
  @@index([companyId, sourceDocumentId])
  @@map("inventory_movements")
}

