  customerCategoryId String?
  currencyCode       String?
  balance            Decimal   @default(0) @db.Decimal(15, 2)
  // Real Estate Investment fields
  contactDate        DateTime?
  contactDateHijri   String?
  gender             String? // ذكر/أنثى
  averagePrice       Decimal?  @db.Decimal(15, 2)
  role               String? // الدور (الأول/الثاني/الثالث)
  marketingChannelId String?
  roomsCount         Int?
  propertyArea       Decimal?  @db.Decimal(15, 2) // Real estate property area
  bathroomsCount     Int?
  facade             String? // الواجهة
  transferTo         String? // بائع/مدير مبيعات
  employeeId         String? // الموظف المسؤول
  followUpDate       DateTime?
  followUpDateHijri  String?
  isActive           Boolean   @default(true)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company                    Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  mainAccount                Account?                    @relation("CustomerMainAccount", fields: [mainAccountId], references: [id])
  linkedSupplier             Supplier?                   @relation("CustomerToLinkedSupplier", fields: [linkedSupplierId], references: [id], onDelete: SetNull)
