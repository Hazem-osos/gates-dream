enum DocumentLayoutType {
  ALL
  CONTRACTOR_INVOICE
  REAL_ESTATE_RECEIPT
  TAX_INVOICE
  DEBIT_NOTE
  PAYMENT_SCHEDULE
}

enum DocumentLayoutPreset {
  LIGHT
  BUBBLE
  WAVE
  CORPORATE_DUAL
  MINIMAL_BORDER
  ARCHITECTURAL_GRID
}

enum DocumentTableStyle {
  LIGHT
  BOXED
  STRIPED
  BUBBLE
  COMPACT
  BORDERLESS
}

enum DocumentPaperSize {
  A4
  LETTER
  A5_LANDSCAPE
}

enum DocumentMarginSize {
  COMPACT_8MM
  NORMAL_15MM
  WIDE_20MM
}

enum DocumentLogoPosition {
  LEFT
  CENTER
  RIGHT
}

/// Print/layout customization profile for generated documents (invoices, receipts,
/// tax documents, …). One row per (company, branch?, documentType); branchId = null
/// means the config applies company-wide unless a branch-specific row overrides it.
model DocumentLayoutConfig {
  id        String  @id @default(uuid())
  companyId String
  branchId  String?

  name         String               @default("تخطيط") @db.VarChar(120)
  isDefault    Boolean              @default(false)
  documentType DocumentLayoutType   @default(ALL)
  layoutPreset DocumentLayoutPreset @default(LIGHT)
  tableStyle   DocumentTableStyle   @default(LIGHT)

  fontFamily     String @default("Cairo") @db.VarChar(60)
  primaryColor   String @default("#1e293b") @db.VarChar(9)
  secondaryColor String @default("#64748b") @db.VarChar(9)
  textColor      String @default("#0f172a") @db.VarChar(9)

  paperSize  DocumentPaperSize  @default(A4)
  marginSize DocumentMarginSize @default(NORMAL_15MM)

  /// Data URL or hosted URL — stored as LongText to safely hold base64 logos.
  logoUrl      String?              @db.LongText
  logoPosition DocumentLogoPosition @default(LEFT)
  logoWidth    Int                  @default(150)

  companyNameAr String? @db.VarChar(200)
  companyNameEn String? @db.VarChar(200)
  taxId         String? @db.VarChar(60)
  commercialReg String? @db.VarChar(60)
  tagline       String? @db.VarChar(200)
  footerText    String? @db.Text

  /// Array of { bankName, accountName, accountNumber, iban, swift }
  bankDetails Json?

  showQrCode             Boolean @default(true)
  showStampAndSignatures Boolean @default(true)
  /// Array of signature label strings, e.g. ["مهندس الموقع", "الاستشاري", "المراجعة المالية", "المدير العام"]
  signatureLabels        Json?

  watermarkText String? @db.VarChar(60)

  /// Column visibility toggles per document type, e.g. { showRetention, showAdvanceDeductions, showUnitDetails, showOverhead }
  columnSettings Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch  Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([companyId, documentType])
  @@index([companyId, isDefault])
  @@map("document_layout_configs")
}

// ============================================
// Gates AI — conversational CFO (read-only tools in later phases)
// ============================================

model AiConversation {
  id        String   @id @default(uuid())
  title     String   @db.VarChar(200)
  userId    String
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messages       AiMessage[]
  toolExecutions AiToolExecution[]
  pendingActions AiPendingAction[]

  @@index([companyId, userId])
  @@index([companyId, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(uuid())
  conversationId String
  /// user | assistant | system | tool
  role           String   @db.VarChar(20)
  content        String   @db.LongText
  toolCalls      Json?
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model AiToolExecution {
  id              String   @id @default(uuid())
  conversationId  String
  toolName        String   @db.VarChar(80)
  inputArgs       Json
  outputResult    Json?
  /// pending | success | error
  status          String   @default("pending") @db.VarChar(20)
  executionTimeMs Int?
  createdAt       DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([toolName])
  @@map("ai_tool_executions")
}

enum AiAuditStatus {
  SUCCESS
  FAILED
  OUT_OF_SCOPE
  BLOCKED_BY_RBAC
}

model AiAuditLog {
  id            String        @id @default(uuid())
  userId        String
  companyId     String
  userRole      String?       @db.VarChar(80)
  currentScreen String?       @db.VarChar(500)
  userPrompt    String?       @db.Text
  toolCalls     Json?
  toolResults   Json?
  aiResponse    String?       @db.LongText
  status        AiAuditStatus @default(SUCCESS)
  latencyMs     Int?
  tokensUsed    Int?
  /// Legacy event name (conversation.create, tool.execute, chat.turn, …)
  action        String        @db.VarChar(80)
  metadata      Json?
  ipAddress     String?       @db.VarChar(45)
  createdAt     DateTime      @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, userId])
  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@index([action])
  @@map("ai_audit_logs")
}

enum AiActionStatus {
  PENDING
  CONFIRMED
  REJECTED
  EXECUTED
  FAILED
  EXPIRED
}

/// Human-in-the-loop write queue. Tools only insert PENDING rows — never execute.
model AiPendingAction {
  id                  String         @id @default(uuid())
  conversationId      String
  companyId           String
  userId              String
  /// e.g. CREATE_QUOTATION | CREATE_INVOICE | CREATE_CUSTOMER
  actionType          String
  /// RBAC key checked on confirm, e.g. invoice:edit
  requiredPermission  String
  payload             Json
  summaryDisplay      Json
  status              AiActionStatus @default(PENDING)
  executionError      String?        @db.Text
  resultingEntityId   String?
  expiresAt           DateTime
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([companyId, userId, status])
  @@index([conversationId])
  @@map("ai_pending_actions")
}

/// RAG corpus categories. Named separately from archive DocumentCategory.
enum AiDocumentCategory {
  CONTRACT
  BOQ_SPECIFICATION
  HR_POLICY
  COMPANY_BYLAW
  TAX_REGULATION
  OTHER
}

/// Company-scoped RAG corpus. Embeddings live in JSON here (MySQL) and
/// optionally in pgvector when VECTOR_DATABASE_URL is configured.
model AiDocument {
  id           String           @id @default(uuid())
  companyId    String
  uploadedById String
  title        String           @db.VarChar(240)
  fileName     String           @db.VarChar(240)
  fileUrl      String           @db.VarChar(500)
  fileSize     Int
  mimeType     String           @db.VarChar(120)
  category     AiDocumentCategory @default(CONTRACT)
  referenceId  String?
  totalChunks  Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedBy User              @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  chunks     AiDocumentChunk[]

  @@index([companyId, category])
  @@index([companyId, referenceId])
  @@map("ai_documents")
}

model AiDocumentChunk {
  id         String @id @default(uuid())
  documentId String
  companyId  String
  chunkIndex Int
  content    String @db.Text
  tokenCount Int
  metadata   Json?
  /// 1536-d embedding (text-embedding-3-small). MySQL JSON; pgvector sidecar mirrors this.
  embedding  Json?

  document AiDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([documentId])
  @@map("ai_document_chunks")
}

