  description        String                     @db.Text
  whyDetected        String                     @db.Text
  status             GrowthOpportunityStatus    @default(NEW)
  priority           GrowthOpportunityPriority  @default(MEDIUM)
  estimatedValue     Decimal                    @default(0) @db.Decimal(18, 4)
  actionedValue      Decimal                    @default(0) @db.Decimal(18, 4)
  realizedValue      Decimal                    @default(0) @db.Decimal(18, 4)
  currencyCode       String                     @default("EGP") @db.VarChar(10)
  module             String?                    @db.VarChar(40)
  entityType         String?                    @db.VarChar(40)
  entityId           String?
  confidence         Decimal                    @default(0) @db.Decimal(5, 2)
  evidence           Json?
  recommendedActions Json?
  metadata           Json?
  generatedBy        String                     @default("growth-engine") @db.VarChar(40)
  aiExplanation      String?                    @db.Text
  reviewedAt         DateTime?
  reviewedBy         String?
  actionedAt         DateTime?
  actionedBy         String?
  resolvedAt         DateTime?
  dismissedAt        DateTime?
  dismissedBy        String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  company      Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actions      GrowthOpportunityAction[]
  attributions GrowthAttribution[]

  @@unique([companyId, fingerprint])
  @@index([companyId, status])
  @@index([companyId, category])
  @@index([companyId, priority])
  @@index([companyId, type])
  @@index([companyId, createdAt])
  @@map("growth_opportunities")
}

model GrowthOpportunityAction {
  id            String   @id @default(uuid())
  companyId     String
  opportunityId String
  actionKey     String   @db.VarChar(60)
  label         String   @db.VarChar(191)
  userId        String?
  notes         String?  @db.Text
  createdAt     DateTime @default(now())

  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunity GrowthOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([companyId, opportunityId])
  @@index([opportunityId, createdAt])
  @@map("growth_opportunity_actions")
}

/// Links a growth opportunity to a later ERP transaction used for realized impact.
model GrowthAttribution {
  id            String   @id @default(uuid())
  companyId     String
  opportunityId String
  kind          String   @db.VarChar(40)
  entityType    String   @db.VarChar(40)
  entityId      String
  amount        Decimal  @db.Decimal(18, 4)
  label         String   @db.VarChar(191)
  isRealized    Boolean  @default(false)
  createdAt     DateTime @default(now())

  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunity GrowthOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([companyId, opportunityId, entityType, entityId], map: "growth_attr_uniq")
  @@index([companyId, opportunityId])
  @@map("growth_attributions")
}
