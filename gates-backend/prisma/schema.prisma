  userId      String?   @db.Char(36)
  companyId   String?   @db.Char(36)
  tenantId    String?   @db.Char(36)
  permissions Json // Array of permission strings
  expiresAt   DateTime? @db.DateTime
  lastUsedAt  DateTime? @db.DateTime
  createdAt   DateTime  @default(now()) @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @db.DateTime(3)

  @@index([userId])
  @@index([companyId])
  @@index([tenantId])
  @@index([expiresAt])
  @@map("api_keys")
}

// System-wide settings (not company-specific)
model SystemSetting {
