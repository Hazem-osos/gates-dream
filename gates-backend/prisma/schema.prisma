enum FinancialAdjustmentNoteType {
  CREDIT_NOTE
  DEBIT_NOTE
  FULL_INVOICE_REVERSAL
}

enum FinancialAdjustmentTargetModule {
  SUBCONTRACT_INVOICE
  CLIENT_INVOICE
}

enum FinancialAdjustmentReasonCategory {
  QUANTITY_CORRECTION
  PENALTY_DISPUTE_WAIVER
  SCRAP_RECONCILIATION_ADJUSTMENT
  RATE_DISCREPANCY
  COMMERCIAL_CONCESSION
  BILLING_ERROR
}

enum FinancialAdjustmentNoteStatus {
  DRAFT
  PENDING_FINANCE_APPROVAL
  POSTED
  REJECTED
}

enum FinancialAdjustmentDeductionType {
  NONE
  RETENTION
  ADVANCE_PAYMENT
  MATERIAL_SCRAP
  SITE_PENALTY
  WHT_TAX
  DIRECT_EXECUTION
}

/// إشعارات دائنة/مدينة وقيود عكسية كاملة بعد ترحيل المستخلص.
model FinancialAdjustmentNote {
  id                       String                            @id @default(uuid())
  companyId                String
  noteNumber               String
  noteType                 FinancialAdjustmentNoteType
  targetModule             FinancialAdjustmentTargetModule
  sourceInvoiceId          String
  subcontractId            String?
  clientContractId         String?
  reasonCategory           FinancialAdjustmentReasonCategory
  reasonDescription        String                            @db.Text
  requestedByUserId        String
  approvedByUserId         String?
  status                   FinancialAdjustmentNoteStatus     @default(DRAFT)
  grossAdjustmentAmount    Decimal                           @db.Decimal(18, 4)
  taxWhtAdjustmentAmount   Decimal                           @default(0) @db.Decimal(18, 4)
  netAdjustmentAmount      Decimal                           @db.Decimal(18, 4)
  journalEntryId           String?
  reversalOfJournalEntryId String?
  attachments              Json?
  createdAt                DateTime                          @default(now())
  updatedAt                DateTime                          @updatedAt

  company                Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subcontract            Subcontract?                  @relation(fields: [subcontractId], references: [id], onDelete: Restrict)
  clientContract         ClientContract?               @relation(fields: [clientContractId], references: [id], onDelete: Restrict)
  journalEntry           JournalEntry?                 @relation("AdjustmentNoteJournal", fields: [journalEntryId], references: [id], onDelete: Restrict)
  reversalOfJournalEntry JournalEntry?                 @relation("AdjustmentNoteReversalOf", fields: [reversalOfJournalEntryId], references: [id], onDelete: Restrict)
  lines                  FinancialAdjustmentLineItem[]

  @@unique([companyId, noteNumber])
  @@index([companyId])
  @@index([sourceInvoiceId])
  @@index([status])
  @@index([subcontractId])
  @@index([clientContractId])
  @@index([journalEntryId])
  @@index([reversalOfJournalEntryId])
  @@map("financial_adjustment_notes")
}

model FinancialAdjustmentLineItem {
  id                    String                           @id @default(uuid())
  adjustmentNoteId      String
  subcontractBOQItemId  String?
  projectBOQItemId      String?
  description           String
  quantityAdjustment    Decimal                          @default(0) @db.Decimal(18, 4)
  unitPrice             Decimal                          @db.Decimal(18, 4)
  totalAmount           Decimal                          @db.Decimal(18, 4)
  deductionTypeAffected FinancialAdjustmentDeductionType @default(NONE)

  adjustmentNote     FinancialAdjustmentNote @relation(fields: [adjustmentNoteId], references: [id], onDelete: Cascade)
  subcontractBOQItem SubcontractBOQItem?     @relation(fields: [subcontractBOQItemId], references: [id], onDelete: Restrict)
  projectBOQItem     ProjectBOQItem?         @relation(fields: [projectBOQItemId], references: [id], onDelete: Restrict)

  @@index([adjustmentNoteId])
  @@index([subcontractBOQItemId])
  @@index([projectBOQItemId])
  @@map("financial_adjustment_line_items")
}

/// عقد المقاولة مع المالك (1-to-1 مع ContractingProject).
model ClientContract {
  id                    String               @id @default(uuid())
  companyId             String
  projectId             String               @unique
  contractNumber        String
  clientCustomerId      String
  contractDate          DateTime
  totalContractValue    Decimal              @db.Decimal(18, 4)
  advancePaymentAmount  Decimal              @default(0) @db.Decimal(18, 4)
  advanceRecoveryRate   Decimal              @default(0) @db.Decimal(8, 6)
  retentionRate         Decimal              @default(0.05) @db.Decimal(8, 6)
  engineeringStampsRate Decimal              @default(0.005) @db.Decimal(8, 6)
  status                ClientContractStatus @default(ACTIVE)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  company                  Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project                  ContractingProject        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  client                   Customer                  @relation(fields: [clientCustomerId], references: [id], onDelete: Restrict)
  invoices                 ClientInvoice[]
  financialAdjustmentNotes FinancialAdjustmentNote[]
  documentAttachments      DocumentAttachment[]

  @@unique([companyId, contractNumber])
  @@index([companyId])
  @@index([status])
  @@index([clientCustomerId])
  @@map("client_contracts")
}

/// مستخلص المالك الجاري والختامي (أعمال + تشوينات + خصومات المالك).
model ClientInvoice {
  id                         String              @id @default(uuid())
  companyId                  String
  clientContractId           String
  invoiceNumber              String
  sequenceNumber             Int
  periodStartDate            DateTime
  periodEndDate              DateTime
  type                       ClientInvoiceType   @default(INTERIM)
  status                     ClientInvoiceStatus @default(DRAFT)
  grossCurrentWorks          Decimal             @default(0) @db.Decimal(18, 4)
  previousGrossWorks         Decimal             @default(0) @db.Decimal(18, 4)
  cumulativeGrossWorks       Decimal             @default(0) @db.Decimal(18, 4)
  materialsOnSiteCurrent     Decimal             @default(0) @db.Decimal(18, 4)
  materialsOnSiteDeduction   Decimal             @default(0) @db.Decimal(18, 4)
  advancePaymentRecovery     Decimal             @default(0) @db.Decimal(18, 4)
  retentionDeduction         Decimal             @default(0) @db.Decimal(18, 4)
  engineeringStampsDeduction Decimal             @default(0) @db.Decimal(18, 4)
  otherClientPenalties       Decimal             @default(0) @db.Decimal(18, 4)
  netPayableByClient         Decimal             @default(0) @db.Decimal(18, 4)
  journalEntryId             String?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt

  company             Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientContract      ClientContract              @relation(fields: [clientContractId], references: [id], onDelete: Restrict)
  journalEntry        JournalEntry?               @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  items               ClientInvoiceItem[]
  measurementSheets   ExecutiveMeasurementSheet[]
  siteStockMaterials  SiteStockMaterial[]
  documentAttachments DocumentAttachment[]

  @@unique([companyId, invoiceNumber])
  @@unique([clientContractId, sequenceNumber])
  @@index([companyId])
  @@index([clientContractId])
  @@index([status])
  @@index([journalEntryId])
  @@map("client_invoices")
}

model ClientInvoiceItem {
  id                 String   @id @default(uuid())
  companyId          String
  clientInvoiceId    String
  projectBOQItemId   String
  previousQuantity   Decimal  @default(0) @db.Decimal(18, 4)
  currentQuantity    Decimal  @default(0) @db.Decimal(18, 4)
  cumulativeQuantity Decimal  @default(0) @db.Decimal(18, 4)
  unitSellingPrice   Decimal  @db.Decimal(18, 4)
  currentAmount      Decimal  @default(0) @db.Decimal(18, 4)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientInvoice  ClientInvoice  @relation(fields: [clientInvoiceId], references: [id], onDelete: Cascade)
  projectBOQItem ProjectBOQItem @relation(fields: [projectBOQItemId], references: [id], onDelete: Restrict)

  @@unique([clientInvoiceId, projectBOQItemId], map: "cli_items_invoice_boq_key")
  @@index([companyId])
  @@index([clientInvoiceId])
  @@index([projectBOQItemId])
  @@map("client_invoice_items")
}

/// تشوينات الموقع المعتمدة لحساب مستخلص المالك.
model SiteStockMaterial {
  id                  String                  @id @default(uuid())
  companyId           String
  projectId           String
  clientInvoiceId     String?
  materialDescription String
  deliveryDate        DateTime
  warehouseReceiptRef String?
  deliveredQuantity   Decimal                 @db.Decimal(18, 4)
  unitPrice           Decimal                 @db.Decimal(18, 4)
  approvedPercentage  Decimal                 @default(0.75) @db.Decimal(8, 6)
  netClaimedAmount    Decimal                 @default(0) @db.Decimal(18, 4)
  status              SiteStockMaterialStatus @default(STORED_ON_SITE)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project       ContractingProject @relation(fields: [projectId], references: [id], onDelete: Restrict)
  clientInvoice ClientInvoice?     @relation(fields: [clientInvoiceId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([projectId])
  @@index([status])
  @@index([clientInvoiceId])
  @@map("site_stock_materials")
}

/// خطابات ضمان المشروع (إصدار / مد / غطاء نقدي).
/// Distinct from the legacy import-export `LetterOfGuarantee` card
/// and from Wave-3 `GuaranteeLetter`.
model ProjectLetterOfGuarantee {
  id                       String          @id @default(uuid())
  companyId                String
  projectId                String
  lgNumber                 String
  bankAccountId            String
  bankName                 String
  beneficiaryName          String
  type                     ProjectLgType
  issuanceDate             DateTime
  expiryDate               DateTime
  originalAmount           Decimal         @db.Decimal(18, 4)
  currentAmount            Decimal         @db.Decimal(18, 4)
  cashMarginRate           Decimal         @db.Decimal(8, 6)
  cashMarginAmount         Decimal         @db.Decimal(18, 4)
  issuanceCommissionAmount Decimal         @default(0) @db.Decimal(18, 4)
  status                   ProjectLgStatus @default(ACTIVE_ISSUED)
  journalEntryId           String?
  renewalCount             Int             @default(0)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project             ContractingProject   @relation(fields: [projectId], references: [id], onDelete: Restrict)
