  branchNumber       String?
  activationNumber   String?
  priceList          String?
  registrationNumber String?
  barcodePrice       String? // e.g., "بالجملة"
  governorate        String?
  district           String?
  streetName         String?
  country            String?
  city               String?
  buildingNumber     String?
  postalCode         String?
  address            String?
  deletedAt          DateTime?
  defaultWarehouseId String?
  defaultSafeId      String?
