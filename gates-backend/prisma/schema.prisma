  productionOrder ProductionOrder               @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  lines           ProductionMaterialIssueLine[]

  @@index([productionOrderId])
  @@map("production_material_issues")
}

model ProductionMaterialIssueLine {
  id              String   @id @default(uuid())
  materialIssueId String
  rawItemId       String
  quantity        Decimal  @db.Decimal(15, 4)
  unitCost        Decimal  @db.Decimal(15, 4)
  totalCost       Decimal  @db.Decimal(15, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  materialIssue ProductionMaterialIssue @relation(fields: [materialIssueId], references: [id], onDelete: Cascade)
  rawItem       Item                    @relation("ProductionIssueRawItem", fields: [rawItemId], references: [id], onDelete: Restrict)

  @@index([materialIssueId])
  @@map("production_material_issue_lines")
}

// ============================================
// M11 / M13 — CONTRACTING & EXTRACTS
// ============================================

model ContractingSettings {
  id                                    String   @id @default(uuid())
  companyId                             String   @unique
  contractingRevenueAccountCode         String?  @db.VarChar(20)
  projectExpenseAccountCode             String?  @db.VarChar(20)
  clientReceivableAccountCode           String?  @db.VarChar(20)
  subcontractorPayableAccountCode       String?  @db.VarChar(20)
  customerAdvanceAccountCode            String?  @db.VarChar(20)
  subcontractorAdvanceAccountCode       String?  @db.VarChar(20)
  retentionHeldByOthersAccountCode      String?  @db.VarChar(20)
  retentionWithheldForOthersAccountCode String?  @db.VarChar(20)
  outputVatAccountCode                  String?  @db.VarChar(20)
  whtAssetAccountCode                   String?  @db.VarChar(20)
  whtPayableAccountCode                 String?  @db.VarChar(20)
  defaultVatRate                        Decimal  @default(0.14) @db.Decimal(8, 6)
  defaultWhtRate                        Decimal  @default(0.01) @db.Decimal(8, 6)
  inputVatAccountCode                   String?  @db.VarChar(20)
  penaltiesExpenseAccountCode           String?  @db.VarChar(20)
  createdAt                             DateTime @default(now())
  updatedAt                             DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("contracting_settings")
}

model ContractingProject {
  id                      String    @id @default(uuid())
  companyId               String
  projectCode             String
  projectName             String
  customerId              String?
  contractValue           Decimal   @default(0) @db.Decimal(15, 2)
  advancePaymentAmount    Decimal   @default(0) @db.Decimal(15, 2)
  advancePaymentBalance   Decimal   @default(0) @db.Decimal(15, 2)
  advanceDeductionPercent Decimal   @default(0) @db.Decimal(8, 4)
  retentionPercent        Decimal   @default(0) @db.Decimal(8, 4)
  costCenterId            String?
  startDate               DateTime?
  endDate                 DateTime?
  /// ACTIVE | COMPLETED | SUSPENDED
  status                  String    @default("ACTIVE") @db.VarChar(20)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  company                    Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer                   Customer?                   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  costCenter                 CostCenter?                 @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  subcontracts               ProjectSubcontract[]
  clientExtracts             ClientExtract[]
  subcontractorExtracts      SubcontractorExtract[]
  boqItems                   ProjectBoqItem[]
  contractExtracts           ContractExtract[]
  enterpriseSubcontracts     Subcontract[]
  ownerBoqItems              ProjectBOQItem[]
  boqMarkupStructures        BOQMarkupStructure[]
  executiveMeasurementSheets ExecutiveMeasurementSheet[]
  clientContract             ClientContract?
  siteStockMaterials         SiteStockMaterial[]
  projectLettersOfGuarantee  ProjectLetterOfGuarantee[]

  @@unique([companyId, projectCode])
  @@index([companyId, status])
  @@map("contracting_projects")
}

/// @deprecated Prefer Subcontract (enterprise BOQ + deduction policy).
model ProjectSubcontract {
  id                     String   @id @default(uuid())
  projectId              String
  subcontractorId        String
  subcontractValue       Decimal  @default(0) @db.Decimal(15, 2)
  advancePaymentBalance  Decimal  @default(0) @db.Decimal(15, 2)
  advanceRecoveryPercent Decimal  @default(0) @db.Decimal(8, 4)
  retentionPercent       Decimal  @default(0) @db.Decimal(8, 4)
  scopeOfWork            String?  @db.Text
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  project          ContractingProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subcontractor    Contractor             @relation(fields: [subcontractorId], references: [id], onDelete: Restrict)
  extracts         SubcontractorExtract[]
  contractExtracts ContractExtract[]

  @@unique([projectId, subcontractorId])
  @@map("project_subcontracts")
}

model ClientExtract {
  id                     String    @id @default(uuid())
  companyId              String
  projectId              String
  extractNumber          String
  periodStart            DateTime?
  periodEnd              DateTime?
  grossAmount            Decimal   @db.Decimal(15, 2)
  advanceDeductionAmount Decimal   @default(0) @db.Decimal(15, 2)
  retentionAmount        Decimal   @default(0) @db.Decimal(15, 2)
  vatAmount              Decimal   @default(0) @db.Decimal(15, 2)
  whtAmount              Decimal   @default(0) @db.Decimal(15, 2)
  netAmount              Decimal   @db.Decimal(15, 2)
  /// DRAFT | APPROVED | POSTED
  status                 String    @default("DRAFT") @db.VarChar(20)
  journalEntryId         String?
  postedAt               DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  project ContractingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([companyId, extractNumber])
  @@index([projectId])
  @@map("client_extracts")
}

/// @deprecated Prefer SubcontractInvoice (immutable deduction breakdown + JE FK).
model SubcontractorExtract {
  id                      String    @id @default(uuid())
  companyId               String
  projectId               String
  projectSubcontractId    String?
  subcontractorId         String
  extractNumber           String
  periodStart             DateTime?
  periodEnd               DateTime?
  grossAmount             Decimal   @db.Decimal(15, 2)
  advanceDeductionAmount  Decimal   @default(0) @db.Decimal(15, 2)
  retentionAmount         Decimal   @default(0) @db.Decimal(15, 2)
  penaltyAmount           Decimal   @default(0) @db.Decimal(15, 2)
  materialDeductionAmount Decimal   @default(0) @db.Decimal(15, 2)
  whtAmount               Decimal   @default(0) @db.Decimal(15, 2)
  netAmount               Decimal   @db.Decimal(15, 2)
  status                  String    @default("DRAFT") @db.VarChar(20)
  journalEntryId          String?
  postedAt                DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  project            ContractingProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectSubcontract ProjectSubcontract? @relation(fields: [projectSubcontractId], references: [id], onDelete: SetNull)
  subcontractor      Contractor          @relation(fields: [subcontractorId], references: [id], onDelete: Restrict)

  @@unique([companyId, extractNumber])
  @@index([projectId, subcontractorId])
  @@map("subcontractor_extracts")
}

model ProjectBoqItem {
  id               String   @id @default(uuid())
  projectId        String
  itemNumber       String
  description      String
  unit             String?  @db.VarChar(20)
  contractQuantity Decimal  @default(0) @db.Decimal(15, 4)
  unitPrice        Decimal  @default(0) @db.Decimal(15, 4)
  totalPrice       Decimal  @default(0) @db.Decimal(15, 2)
  lineOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project      ContractingProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  extractLines ContractExtractLine[]

  @@unique([projectId, itemNumber])
  @@index([projectId])
  @@map("project_boq_items")
}

model ContractExtract {
  id                      String    @id @default(uuid())
  companyId               String
  projectId               String
  projectSubcontractId    String?
  extractNumber           String
  /// CLIENT | SUBCONTRACTOR
  extractType             String    @db.VarChar(20)
  /// Customer id (client) or Contractor id (subcontractor)
  partyId                 String
  extractDate             DateTime  @default(now())
  periodStart             DateTime?
  periodEnd               DateTime?
  totalExecutedAmount     Decimal   @default(0) @db.Decimal(15, 2)
  previousExecutedAmount  Decimal   @default(0) @db.Decimal(15, 2)
  currentExecutedAmount   Decimal   @default(0) @db.Decimal(15, 2)
  advancePaymentDeduction Decimal   @default(0) @db.Decimal(15, 2)
  retentionDeduction      Decimal   @default(0) @db.Decimal(15, 2)
  whtDeduction            Decimal   @default(0) @db.Decimal(15, 2)
  otherDeductions         Decimal   @default(0) @db.Decimal(15, 2)
  penalties               Decimal   @default(0) @db.Decimal(15, 2)
  netBeforeVat            Decimal   @default(0) @db.Decimal(15, 2)
  vatAmount               Decimal   @default(0) @db.Decimal(15, 2)
  netPayableAmount        Decimal   @default(0) @db.Decimal(15, 2)
  /// DRAFT | APPROVED | POSTED
  status                  String    @default("DRAFT") @db.VarChar(20)
  /// Private ERP-only staff notes (JSON array)
  internalNotes           Json?
  journalEntryId          String?
  postedAt                DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  company            Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project            ContractingProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectSubcontract ProjectSubcontract?   @relation(fields: [projectSubcontractId], references: [id], onDelete: SetNull)
  lines              ContractExtractLine[]

  @@unique([companyId, extractNumber])
  @@index([projectId, extractType])
  @@index([partyId])
  @@map("contract_extracts")
}

model ContractExtractLine {
  id                 String  @id @default(uuid())
  extractId          String
  boqItemId          String
  previousQuantity   Decimal @default(0) @db.Decimal(15, 4)
  currentQuantity    Decimal @default(0) @db.Decimal(15, 4)
  cumulativeQuantity Decimal @default(0) @db.Decimal(15, 4)
  unitPrice          Decimal @default(0) @db.Decimal(15, 4)
  lineTotal          Decimal @default(0) @db.Decimal(15, 2)
  lineOrder          Int     @default(0)

  extract ContractExtract @relation(fields: [extractId], references: [id], onDelete: Cascade)
  boqItem ProjectBoqItem  @relation(fields: [boqItemId], references: [id], onDelete: Restrict)

  @@index([extractId])
  @@index([boqItemId])
  @@map("contract_extract_lines")
}

// ============================================
// ENTERPRISE SUBCONTRACTORS & MOSTAKHLASSAT
// Replaces the fragmented Contractor / ProjectSubcontract /
// SubcontractorExtract / Extract stack for new work. Those tables stay
// mapped (see deprecation notes below) so Wave 3 posting keep compiling.
// organizationId in the product spec is companyId here.
// ============================================

enum SubcontractorStatus {
  ACTIVE
  SUSPENDED
  BLACKLISTED
}

enum SubcontractStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  COMPLETED
  TERMINATED
}

enum SubcontractInvoiceType {
  INTERIM_RUNNING
  FINAL_SETTLEMENT
}

enum SubcontractInvoiceStatus {
  DRAFT
  SITE_SUBMITTED
  CONSULTANT_APPROVED
  TECH_OFFICE_APPROVED
  FINANCE_POSTED
  REJECTED
  PAID
  REVERSED
}

enum MaterialReconciliationStatus {
  PENDING_DEDUCTION
  DEDUCTED
  WAIVED
}

enum SitePenaltyType {
  DELAY_PENALTY
  NCR_QUALITY_DEFECT
  HSE_SAFETY_VIOLATION
  MANPOWER_SHORTAGE
  EQUIPMENT_DEMURRAGE
}

enum SitePenaltyStatus {
  PENDING
  DISPUTED
  APPROVED_FOR_DEDUCTION
  APPLIED_TO_INVOICE
}

enum DirectExecutionStatus {
  PENDING
  APPLIED
}

model Subcontractor {
  id                    String              @id @default(uuid())
  companyId             String
  nameAr                String
  nameEn                String?
  taxRegistrationNumber String?
  commercialRegister    String?
  phone                 String?
  email                 String?
  address               String?             @db.Text
  status                SubcontractorStatus @default(ACTIVE)
  bankAccountDetails    Json?
  riskScore             Float               @default(100)
  /// Bridge to the legacy `contractors` card when a vendor was already onboarded there.
  legacyContractorId    String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subcontracts Subcontract[]

  @@unique([companyId, taxRegistrationNumber])
  @@index([companyId, status])
  @@index([legacyContractorId])
  @@map("subcontractors")
}

model Subcontract {
  id                 String            @id @default(uuid())
  companyId          String
  subcontractNumber  String
  subcontractorId    String
  projectId          String
  contractDate       DateTime
  totalContractValue Decimal           @db.Decimal(18, 4)
  status             SubcontractStatus @default(DRAFT)

  advancePaymentTotal          Decimal @default(0) @db.Decimal(18, 4)
  advancePaymentRecoveryRate   Decimal @default(0.10) @db.Decimal(8, 6)
  retentionRate                Decimal @default(0.05) @db.Decimal(8, 6)
  taxWithholdingRate           Decimal @default(0.01) @db.Decimal(8, 6)
  socialInsuranceRate          Decimal @default(0) @db.Decimal(8, 6)
  maxAllowedVariationOrderRate Decimal @default(0.20) @db.Decimal(8, 6)
  standardScrapToleranceRate   Decimal @default(0.05) @db.Decimal(8, 6)
  contractAdminOverheadRate    Decimal @default(0.15) @db.Decimal(8, 6)
  earlyPaymentDiscountRate     Decimal @default(0.03) @db.Decimal(8, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company                  Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subcontractor            Subcontractor               @relation(fields: [subcontractorId], references: [id], onDelete: Restrict)
  project                  ContractingProject          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  boqItems                 SubcontractBOQItem[]
  invoices                 SubcontractInvoice[]
  materialReconciliations  MaterialReconciliationLog[]
  sitePenalties            SitePenaltyAndSnag[]
  directExecutionCharges   DirectExecutionCharge[]
  financialAdjustmentNotes FinancialAdjustmentNote[]
  documentAttachments      DocumentAttachment[]

  @@unique([companyId, subcontractNumber])
  @@index([subcontractorId])
  @@index([projectId])
  @@index([status])
  @@map("subcontracts")
}

model SubcontractBOQItem {
  id                    String   @id @default(uuid())
  subcontractId         String
  itemCode              String
  descriptionAr         String
  descriptionEn         String?
  unit                  String   @db.VarChar(20)
  contractQuantity      Decimal  @db.Decimal(18, 4)
  unitPrice             Decimal  @db.Decimal(18, 4)
  totalPrice            Decimal  @db.Decimal(18, 4)
  maxAllowedQuantity    Decimal  @db.Decimal(18, 4)
  cumulativeExecutedQty Decimal  @default(0) @db.Decimal(18, 4)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  subcontract     Subcontract                   @relation(fields: [subcontractId], references: [id], onDelete: Cascade)
  invoiceItems    SubcontractInvoiceItem[]
  adjustmentLines FinancialAdjustmentLineItem[]

  @@unique([subcontractId, itemCode])
  @@index([subcontractId])
  @@map("subcontract_boq_items")
}

model SubcontractInvoice {
  id              String                   @id @default(uuid())
  companyId       String
  subcontractId   String
  invoiceNumber   String
  sequenceNumber  Int
  periodStartDate DateTime
  periodEndDate   DateTime
  type            SubcontractInvoiceType   @default(INTERIM_RUNNING)
  status          SubcontractInvoiceStatus @default(DRAFT)

  grossCurrentAmount            Decimal @default(0) @db.Decimal(18, 4)
  grossCumulativeAmount         Decimal @default(0) @db.Decimal(18, 4)
  previousGrossAmount           Decimal @default(0) @db.Decimal(18, 4)
  advancePaymentDeduction       Decimal @default(0) @db.Decimal(18, 4)
  retentionDeduction            Decimal @default(0) @db.Decimal(18, 4)
  taxWithholdingDeduction       Decimal @default(0) @db.Decimal(18, 4)
  socialInsuranceDeduction      Decimal @default(0) @db.Decimal(18, 4)
  materialOveruseDeduction      Decimal @default(0) @db.Decimal(18, 4)
  sitePenaltiesDeduction        Decimal @default(0) @db.Decimal(18, 4)
  directExecutionDeduction      Decimal @default(0) @db.Decimal(18, 4)
  earlyPaymentDiscountDeduction Decimal @default(0) @db.Decimal(18, 4)
  netPayableAmount              Decimal @default(0) @db.Decimal(18, 4)

  journalEntryId String?
  attachments    Json?
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company                 Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subcontract             Subcontract                 @relation(fields: [subcontractId], references: [id], onDelete: Restrict)
  journalEntry            JournalEntry?               @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  items                   SubcontractInvoiceItem[]
  materialReconciliations MaterialReconciliationLog[]
  sitePenalties           SitePenaltyAndSnag[]
  directExecutionCharges  DirectExecutionCharge[]
  documentAttachments     DocumentAttachment[]

  @@unique([companyId, invoiceNumber])
  @@unique([subcontractId, sequenceNumber])
  @@index([subcontractId])
  @@index([status])
  @@index([journalEntryId])
  @@map("subcontract_invoices")
}

model SubcontractInvoiceItem {
  id                      String  @id @default(uuid())
  subcontractInvoiceId    String
  subcontractBOQItemId    String
  previousQuantity        Decimal @default(0) @db.Decimal(18, 4)
  currentQuantity         Decimal @default(0) @db.Decimal(18, 4)
  totalCumulativeQuantity Decimal @default(0) @db.Decimal(18, 4)
  completionPercentage    Decimal @default(0) @db.Decimal(8, 4)
  unitPrice               Decimal @db.Decimal(18, 4)
  totalCurrentAmount      Decimal @default(0) @db.Decimal(18, 4)

  invoice SubcontractInvoice @relation(fields: [subcontractInvoiceId], references: [id], onDelete: Cascade)
  boqItem SubcontractBOQItem @relation(fields: [subcontractBOQItemId], references: [id], onDelete: Restrict)

  @@unique([subcontractInvoiceId, subcontractBOQItemId], map: "sci_items_invoice_boq_key")
  @@index([subcontractInvoiceId])
  @@index([subcontractBOQItemId])
  @@map("subcontract_invoice_items")
}

model MaterialReconciliationLog {
  id                       String                       @id @default(uuid())
  subcontractId            String
  subcontractInvoiceId     String?
  itemId                   String
  warehouseIssueSlipNumber String?
  standardEngineeredQty    Decimal                      @db.Decimal(18, 4)
  actualIssuedQty          Decimal                      @db.Decimal(18, 4)
  scrapExcessQty           Decimal                      @default(0) @db.Decimal(18, 4)
  marketPricePerUnit       Decimal                      @db.Decimal(18, 4)
  adminOverheadPercentage  Decimal                      @db.Decimal(8, 6)
  totalPenaltyAmount       Decimal                      @default(0) @db.Decimal(18, 4)
  status                   MaterialReconciliationStatus @default(PENDING_DEDUCTION)
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt

  subcontract         Subcontract          @relation(fields: [subcontractId], references: [id], onDelete: Cascade)
  invoice             SubcontractInvoice?  @relation(fields: [subcontractInvoiceId], references: [id], onDelete: SetNull)
  item                Item                 @relation(fields: [itemId], references: [id], onDelete: Restrict)
  documentAttachments DocumentAttachment[]

  @@index([subcontractId])
  @@index([subcontractInvoiceId])
  @@index([itemId])
  @@index([status])
  @@map("material_reconciliation_logs")
}

model SitePenaltyAndSnag {
  id                   String            @id @default(uuid())
  subcontractId        String
  subcontractInvoiceId String?
  penaltyType          SitePenaltyType
  amount               Decimal           @db.Decimal(18, 4)
  incidentDate         DateTime
  description          String            @db.Text
  consultantReportRef  String?
  status               SitePenaltyStatus @default(PENDING)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  subcontract         Subcontract          @relation(fields: [subcontractId], references: [id], onDelete: Cascade)
  invoice             SubcontractInvoice?  @relation(fields: [subcontractInvoiceId], references: [id], onDelete: SetNull)
  documentAttachments DocumentAttachment[]

  @@index([subcontractId])
  @@index([subcontractInvoiceId])
  @@index([status])
  @@index([incidentDate])
  @@map("site_penalties_and_snags")
}

model DirectExecutionCharge {
  id                    String                @id @default(uuid())
  subcontractId         String
  subcontractInvoiceId  String?
  reason                String                @db.Text
  thirdPartyVendorName  String?
  directCostIncurred    Decimal               @db.Decimal(18, 4)
  overheadSurchargeRate Decimal               @db.Decimal(8, 6)
  totalDeduction        Decimal               @db.Decimal(18, 4)
  status                DirectExecutionStatus @default(PENDING)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  subcontract Subcontract         @relation(fields: [subcontractId], references: [id], onDelete: Cascade)
  invoice     SubcontractInvoice? @relation(fields: [subcontractInvoiceId], references: [id], onDelete: SetNull)

  @@index([subcontractId])
  @@index([subcontractInvoiceId])
  @@index([status])
  @@map("direct_execution_charges")
}

// ============================================
// TECHNICAL OFFICE + OWNER BILLING + PROJECT LGs
// Owner-side BOQ / measurement sheets / client extracts / bank guarantees.
// Does not replace Subcontract* (Module A), UnitContract (Module B),
// legacy ProjectBoqItem / ClientExtract, or the import-export LetterOfGuarantee card.
// ============================================

enum BOQItemUnit {
  M2
  M3
  TON
  ITEM
  LM
  LS
}

enum ProjectBOQItemStatus {
  PENDING_PRICING
  PRICED
  APPROVED_IN_CONTRACT
}

enum BOQCostElementType {
  MATERIAL
  LABOR
  EQUIPMENT
  SUBCONTRACTOR
  SITE_EXPENSE
}

enum MeasurementSheetStatus {
  DRAFT
  SITE_ENGINEER_VERIFIED
  CONSULTANT_APPROVED
  INVOICED_IN_EXTRACT
}

enum ClientContractStatus {
  ACTIVE
  SUSPENDED
  COMPLETED
}

enum ClientInvoiceType {
  INTERIM
  FINAL_SETTLEMENT
}

enum ClientInvoiceStatus {
  DRAFT
  SUBMITTED_TO_CLIENT
  CLIENT_APPROVED
  FINANCE_POSTED
  REJECTED
  PAID
  REVERSED
}

enum SiteStockMaterialStatus {
  STORED_ON_SITE
  INSTALLED_AND_DEDUCTED
  REJECTED
}

enum ProjectLgType {
  BID_BOND_INITIAL
  ADVANCE_PAYMENT_BOND
  PERFORMANCE_BOND_FINAL
  RETENTION_RELEASE_BOND
}

enum ProjectLgStatus {
  ACTIVE_ISSUED
  EXTENDED
  AMENDED_VALUE
  RELEASED_RETURNED
  LIQUIDATED_CONFISCATED
}

enum LgActionType {
  ISSUANCE
  EXTENSION
  VALUE_INCREASE
  VALUE_DECREASE
  RELEASE_RETURN
  LIQUIDATION
}

/// مقايسة المشروع التنفيذية مع المالك (distinct from legacy ProjectBoqItem).
model ProjectBOQItem {
  id                    String               @id @default(uuid())
  companyId             String
  projectId             String
  itemCode              String
  descriptionAr         String
  descriptionEn         String?
  unit                  BOQItemUnit
  contractQuantity      Decimal              @db.Decimal(18, 4)
  directCostEstimated   Decimal              @default(0) @db.Decimal(18, 4)
  indirectMarkupRate    Decimal              @default(0.20) @db.Decimal(8, 6)
  unitSellingPrice      Decimal              @default(0) @db.Decimal(18, 4)
  totalSellingPrice     Decimal              @default(0) @db.Decimal(18, 4)
  cumulativeExecutedQty Decimal              @default(0) @db.Decimal(18, 4)
  status                ProjectBOQItemStatus @default(PENDING_PRICING)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  company            Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project            ContractingProject            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  rateAnalysisItems  BOQRateAnalysisItem[]
  markupStructures   BOQMarkupStructure[]
  measurementSheets  ExecutiveMeasurementSheet[]
  clientInvoiceItems ClientInvoiceItem[]
  adjustmentLines    FinancialAdjustmentLineItem[]

  @@unique([companyId, projectId, itemCode])
  @@index([companyId])
  @@index([projectId])
  @@index([status])
  @@map("project_owner_boq_items")
}

/// تفكيك عناصر تكلفة البند (خامات، عمالة، معدات، مقاول باطن، مصاريف موقع).
model BOQRateAnalysisItem {
  id                      String             @id @default(uuid())
  companyId               String
  projectBOQItemId        String
  costElementType         BOQCostElementType
  resourceCode            String?
  descriptionAr           String
  descriptionEn           String?
  unit                    String             @db.VarChar(20)
  consumptionQuotaPerUnit Decimal            @db.Decimal(18, 4)
  unitCost                Decimal            @db.Decimal(18, 4)
  wasteFactorRate         Decimal            @default(0) @db.Decimal(8, 6)
  totalCostPerUnit        Decimal            @db.Decimal(18, 4)
  notes                   String?            @db.Text
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectBOQItem ProjectBOQItem @relation(fields: [projectBOQItemId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([projectBOQItemId])
  @@index([costElementType])
  @@map("boq_rate_analysis_items")
}

/// هيكل تحميل التكاليف غير المباشرة للبند أو للمقايسة كاملة.
