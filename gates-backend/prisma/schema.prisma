/// Administrative fulfillment for cash orders (أمر صرف / أمر توريد) — not GL posting.
enum OrderExecutionStatus {
  PENDING
  COMPLETED
  CANCELLED
}

// Wave 1 M2 — unified cash receipt/payment document
model CashTransaction {
  id                String        @id @default(uuid())
  companyId         String
  branchId          String?
  fiscalYearId      String?
  /// RECEIPT | PAYMENT
  transactionKind   String        @db.VarChar(20)
  voucherNumber     String?
  date              DateTime
  description       String?       @db.Text
  amount            Decimal       @db.Decimal(15, 2)
  currencyCode      String
  customerId        String?
  supplierId        String?
  offsetAccountId   String?
  safeId            String?
  bankAccountId     String?
  /// Wave 2 fix: FX rate in effect for this cash movement. When set and it
  /// differs from the settled invoice's own booked rate, the difference is
  /// posted as a realized FX gain/loss instead of always assuming rate 1.
  exchangeRate      Decimal?      @db.Decimal(18, 6)
  hijriDate         String?
  /// SWIFT / transfer / bank advice number (إشعارات البنك)
  bankReference     String?
  valueDate         DateTime?
  isRecurring       Boolean       @default(false)
  /// ORDER = أمر صرف | VOUCHER = سند صرف
  documentRole      String        @default("VOUCHER") @db.VarChar(20)
  departmentId      String?
  sourceOrderId     String?
  /// Set when this transaction settles an M5 invoice (drives paidAmount/remainingAmount)
  invoiceId         String?
  treasuryReceiptId String?       @unique
  treasuryPaymentId String?       @unique
  journalEntryId    String?
  journalEntry      JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  isPosted          Boolean       @default(false)
  postedAt          DateTime?
  postedBy          String?
  isCancelled       Boolean       @default(false)
  /// Fulfillment of an ORDER (أمر). Vouchers stay PENDING unused.
  executionStatus   OrderExecutionStatus @default(PENDING)
  executedAt        DateTime?
  executedBy        String?
  createdBy         String?
  /// DRAFT | PENDING_APPROVAL | APPROVED | POSTED
  workflowStatus    String        @default("DRAFT") @db.VarChar(30)
  /// [{ userId, name, status, approvedAt }]
  approvalState     Json?
  /// Voucher optimistic lock (spec Voucher.version). Bumped on every save/post/cancel.
  version           Int           @default(1)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  company               Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch                Branch?                 @relation(fields: [branchId], references: [id], onDelete: SetNull)
  fiscalYear            FiscalYear?             @relation(fields: [fiscalYearId], references: [id], onDelete: SetNull)
  customer              Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier              Supplier?               @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  offsetAccount         Account?                @relation(fields: [offsetAccountId], references: [id], onDelete: SetNull)
  safe                  Safe?                   @relation(fields: [safeId], references: [id], onDelete: SetNull)
  bankAccount           BankAccount?            @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  invoice               Invoice?                @relation("InvoiceSettlements", fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceInstallmentId  String?
  invoiceInstallment    InvoiceInstallment?     @relation(fields: [invoiceInstallmentId], references: [id], onDelete: SetNull)
  treasuryReceipt       TreasuryReceipt?        @relation(fields: [treasuryReceiptId], references: [id], onDelete: SetNull)
  treasuryPayment       TreasuryPayment?        @relation(fields: [treasuryPaymentId], references: [id], onDelete: SetNull)
  unitInstallments      UnitInstallment[]
  schoolFeeInstallments StudentFeeInstallment[]
  paymentAllocations    PaymentAllocation[]
  lines                 CashTransactionLine[]
  department            Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  sourceOrder           CashTransaction?      @relation("CashOrderVoucher", fields: [sourceOrderId], references: [id], onDelete: SetNull)
  vouchersFromOrder     CashTransaction[]     @relation("CashOrderVoucher")

  @@index([companyId, date])
  @@index([invoiceId])
  @@index([invoiceInstallmentId])
  @@index([companyId, safeId, isPosted, date])
  @@index([departmentId])
  @@index([sourceOrderId])
  @@index([companyId, documentRole, transactionKind])
  @@index([companyId, documentRole, executionStatus])
  @@index([companyId, isRecurring])
  @@map("cash_transactions")
}

model CashTransactionLine {
  id                String   @id @default(uuid())
  companyId         String
  cashTransactionId String
  accountId         String
  description       String?  @db.Text
  amount            Decimal  @db.Decimal(15, 2)
  currencyCode      String
  exchangeRate      Decimal  @default(1) @db.Decimal(18, 6)
  costCenterId      String?
  /// DEBIT = بنود السند الرئيسية | CREDIT = أطراف دائنة أخرى
  entrySide         String   @default("DEBIT") @db.VarChar(10)
  isTiedToInvoice   Boolean  @default(false)
  invoiceId         String?
  lineOrder         Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cashTransaction CashTransaction @relation(fields: [cashTransactionId], references: [id], onDelete: Cascade)
  account         Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  costCenter      CostCenter?     @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  invoice         Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([cashTransactionId])
  @@index([accountId])
  @@index([costCenterId])
  @@index([invoiceId])
  @@map("cash_transaction_lines")
}

model ExchangeRateHistory {
  id           String   @id @default(uuid())
  companyId    String
  currencyCode String
  rate         Decimal  @db.Decimal(18, 6)
  sourceType   String   @db.VarChar(40)
  sourceId     String?
  userId       String?
  recordedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, currencyCode, recordedAt])
  @@map("exchange_rate_histories")
}

/// Open-item allocation: links a posted cash receipt/payment to specific invoices.
model PaymentAllocation {
  id                   String   @id @default(uuid())
  companyId            String
  cashTransactionId    String
  invoiceId            String
  counterpartyOffsetId String?
  allocatedAmount      Decimal  @db.Decimal(15, 2)
  allocatedAt          DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // H14 fix: payment-to-invoice allocation history is financial history — never
  // let a company/cashTransaction/invoice hard-delete silently wipe it out.
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  cashTransaction    CashTransaction     @relation(fields: [cashTransactionId], references: [id], onDelete: Restrict)
  invoice            Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  counterpartyOffset CounterpartyOffset? @relation(fields: [counterpartyOffsetId], references: [id], onDelete: SetNull)

  @@index([companyId, invoiceId])
  @@index([cashTransactionId])
  @@index([counterpartyOffsetId])
  @@map("payment_allocations")
}

/// AR/AP netting between linked customer and supplier (مقاصة)
model CounterpartyOffset {
  id             String   @id @default(uuid())
  companyId      String
  branchId       String?
  fiscalYearId   String?
  voucherNumber  String?
  date           DateTime
  amount         Decimal  @db.Decimal(18, 4)
  customerId     String
  supplierId     String
  journalEntryId String?
  description    String?  @db.Text
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch             Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  fiscalYear         FiscalYear?         @relation(fields: [fiscalYearId], references: [id], onDelete: SetNull)
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplier           Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  journalEntry       JournalEntry?       @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  paymentAllocations PaymentAllocation[]

  @@index([companyId, date])
  @@index([customerId])
  @@index([supplierId])
  @@map("counterparty_offsets")
}

/// أوراق قبض (وارد من عميل) / أوراق دفع (صادر لمورد)
enum ChequeDirection {
  INWARD
  OUTWARD
}

/// دورة حياة الشيك — يمنع تجاوز الحالة عبر VARCHAR حر
enum ChequeStatus {
  UNDER_HAND
  SENT_TO_BANK
  COLLECTED
  ENDORSED
  BOUNCED
  RETURNED_TO_DRAWER
  CANCELLED
}

/// Inward/outward cheque lifecycle (أوراق قبض / أوراق دفع)
model Cheque {
  id                      String          @id @default(uuid())
  companyId               String
  branchId                String?
  fiscalYearId            String?
  direction               ChequeDirection
  status                  ChequeStatus    @default(UNDER_HAND)
  chequeNumber            String
  bankName                String?
  dueDate                 DateTime?
  amount                  Decimal   @db.Decimal(15, 2)
  currencyCode            String
  sourceYearId            String?   @db.VarChar(20)
  customerId              String?
  supplierId              String?
  bankAccountId           String?
  description             String?   @db.Text
  invoiceId               String?
  portfolioJournalEntryId String?
  depositJournalEntryId   String?
  clearJournalEntryId     String?
  issueJournalEntryId     String?
  cancelJournalEntryId    String?
  /// L2 fix (Item 41): the supplier an INWARD cheque was endorsed (تظهير) to
  /// — handed over as-is to settle a payable instead of being deposited.
  /// Set together with `status = 'ENDORSED'` and `endorseJournalEntryId`.
  endorsedSupplierId      String?
  endorseJournalEntryId   String?
  /// Wave 2 fix: previously the bounce JE id was never stored anywhere on
  /// the cheque, making a bounce impossible to reverse. Set together with
  /// `status = 'BOUNCED'`.
  bounceJournalEntryId    String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  company               Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch                Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  fiscalYear            FiscalYear?       @relation(fields: [fiscalYearId], references: [id], onDelete: SetNull)
  customer              Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier              Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  endorsedSupplier      Supplier?         @relation("ChequeEndorsedSupplier", fields: [endorsedSupplierId], references: [id], onDelete: SetNull)
  bankAccount           BankAccount?      @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  invoice               Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  portfolioJournalEntry JournalEntry?     @relation("ChequePortfolioJe", fields: [portfolioJournalEntryId], references: [id], onDelete: SetNull)
  depositJournalEntry   JournalEntry?     @relation("ChequeDepositJe", fields: [depositJournalEntryId], references: [id], onDelete: SetNull)
  clearJournalEntry     JournalEntry?     @relation("ChequeClearJe", fields: [clearJournalEntryId], references: [id], onDelete: SetNull)
  issueJournalEntry     JournalEntry?     @relation("ChequeIssueJe", fields: [issueJournalEntryId], references: [id], onDelete: SetNull)
  cancelJournalEntry    JournalEntry?     @relation("ChequeCancelJe", fields: [cancelJournalEntryId], references: [id], onDelete: SetNull)
  bounceJournalEntry    JournalEntry?     @relation("ChequeBounceJe", fields: [bounceJournalEntryId], references: [id], onDelete: SetNull)
  endorseJournalEntry   JournalEntry?     @relation("ChequeEndorseJe", fields: [endorseJournalEntryId], references: [id], onDelete: SetNull)
  unitInstallments      UnitInstallment[]

  @@unique([companyId, chequeNumber, direction])
  @@index([companyId, status])
  @@index([companyId, direction, status])
  @@index([invoiceId])
  @@index([endorsedSupplierId])
  @@map("cheques")
}

/// Legacy BankBoxRights — per-user safe/bank access
model BankBoxRight {
  id            String   @id @default(uuid())
  companyId     String
  userId        String
  safeId        String?
  bankAccountId String?
  canView       Boolean  @default(true)
  canPost       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  safe        Safe?        @relation(fields: [safeId], references: [id], onDelete: Cascade)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId, safeId, bankAccountId])
  @@index([companyId, userId])
  @@map("bank_box_rights")
}

// ============================================
// SECURITIES MODULE MODELS
// ============================================

// Securities Receipt
model SecuritiesReceipt {
  id             String    @id @default(uuid())
  companyId      String
  branchId       String?
  serial         String?
  receiptNumber  String?
  date           DateTime
  hijriDate      String?
  description    String?   @db.Text
  securityType   String // 'check' | 'promissory-note' | 'bond' | 'other'
  // Source (who gave the security)
  customerId     String?
  supplierId     String?
  // Security details
  issuerName     String?
  issuerBank     String?
  securityNumber String?
  dueDate        DateTime?
  amount         Decimal   @db.Decimal(15, 2)
  currencyCode   String
  /// الجهة التابع لها الساحب / العميل
  entityName             String?
  destinationAccountId   String?
  commissionAmount       Decimal?  @db.Decimal(15, 2)
  commissionAccountId    String?
  // Status
  isReceived     Boolean   @default(true)
  isPosted       Boolean   @default(false)
  postedAt       DateTime?
  isApproved     Boolean   @default(false)
  approvedAt     DateTime?
  isCancelled    Boolean   @default(false)
  cancelledAt    DateTime?
  /// ISSUED | COLLECTED | BOUNCED | ENDORSED | MULTI_COLLECTED
  paperCase String @default("ISSUED") @db.VarChar(24)
  // H11: real GL posting on post/unpost, mirroring the Cheque lifecycle instead
  // of a phantom isPosted flag with no accounting effect.
  journalEntryId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@unique([companyId, receiptNumber])
  @@index([companyId, date])
  @@index([receiptNumber])
  @@index([securityType])
  @@map("securities_receipts")
}

// Securities Payment
model SecuritiesPayment {
  id             String    @id @default(uuid())
  companyId      String
  branchId       String?
  serial         String?
  paymentNumber  String?
  date           DateTime
  hijriDate      String?
  description    String?   @db.Text
  securityType   String // 'check' | 'promissory-note' | 'bond' | 'other'
  // Destination (who receives the security)
  customerId     String?
  supplierId     String?
  // Security details
  payeeName      String?
  payeeBank      String?
  securityNumber String?
  dueDate        DateTime?
  amount         Decimal   @db.Decimal(15, 2)
  currencyCode   String
  /// الجهة التابع لها المستفيد
  entityName             String?
  destinationAccountId   String?
  commissionAmount       Decimal?  @db.Decimal(15, 2)
  commissionAccountId    String?
  // Status
  isPaid         Boolean   @default(true)
  isPosted       Boolean   @default(false)
  postedAt       DateTime?
  isApproved     Boolean   @default(false)
  approvedAt     DateTime?
  isCancelled    Boolean   @default(false)
  cancelledAt    DateTime?
  /// ISSUED | COLLECTED | MULTI_COLLECTED | ENDORSED | BOUNCED — one case at a time
  paperCase      String    @default("ISSUED") @db.VarChar(24)
  // H11: real GL posting on post/unpost, mirroring the Cheque lifecycle instead
  // of a phantom isPosted flag with no accounting effect.
  journalEntryId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@unique([companyId, paymentNumber])
  @@index([companyId, date])
  @@index([paymentNumber])
  @@index([securityType])
  @@map("securities_payments")
}

/// سجلات التحصيل المتعدد لأوراق القبض / الصرف
model MultiCollectionLine {
  id             String   @id @default(uuid())
  companyId      String
  paperKind      String   @db.VarChar(20) // PAYMENT | RECEIPT
  paperId        String
  accountId      String
  amount         Decimal  @db.Decimal(15, 2)
  description    String?
  collectionDate DateTime @default(now())
  hijriDate      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id])

  @@index([companyId, paperKind, paperId])
  @@index([accountId])
  @@map("multi_collection_lines")
}

// Securities Renewal
model SecuritiesRenewal {
  id                   String    @id @default(uuid())
  companyId            String
  branchId             String?
  serial               String?
  renewalNumber        String?
  date                 DateTime
  hijriDate            String?
  description          String?   @db.Text
  // Original security
  originalSecurityId   String? // Reference to receipt or payment
  originalSecurityType String? // 'receipt' | 'payment'
  // Renewal details
  newDueDate           DateTime?
  newAmount            Decimal?  @db.Decimal(15, 2)
  renewalFee           Decimal?  @db.Decimal(15, 2)
  // Status
  isPosted             Boolean   @default(false)
  postedAt             DateTime?
  isApproved           Boolean   @default(false)
  approvedAt           DateTime?
  isCancelled          Boolean   @default(false)
  cancelledAt          DateTime?
  // Wave 2 fix: real GL posting for the renewal fee (H11-style), instead of a
  // phantom isPosted flag with no accounting effect.
  journalEntryId       String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, renewalNumber])
  @@index([companyId, date])
  @@index([renewalNumber])
  @@map("securities_renewals")
}

// ============================================
// INVENTORY MODULE MODELS
// ============================================

// Units
model Unit {
  id          String   @id @default(uuid())
  companyId   String
  code        String?
  arabicName  String
  englishName String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company                Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  itemUnits              ItemUnit[]
  itemPrices             ItemPrice[]
  invoiceLines           InvoiceLine[]
  invoiceLineBaseUnits   InvoiceLine[]      @relation("InvoiceLineBaseUnit")
  stocktakingLines       StocktakingLine[]
  purchaseOrderLines     PurchaseOrderLine[]
  purchaseOrderBaseUnits PurchaseOrderLine[]  @relation("BaseUnit")
  priceQuoteLines        PriceQuoteLine[]
  priceQuoteBaseUnits    PriceQuoteLine[]     @relation("BaseUnit")
  itemOffers             ItemOffer[]          @relation("OfferSourceUnit")
  PurchaseReturnLine     PurchaseReturnLine[]
  personItemPrices       PersonItemPrice[]
  posOrderLines          PosOrderLine[]

  @@unique([companyId, code])
  @@map("units")
}

// Items
// Item Categories — drive GL-account defaulting for items (Sales Invoice
// Enterprise Redesign): when an item is created under a category, any blank
// mainAccountId/salesAccountId/cogsAccountId on the item is snapshotted from
// the category's defaults at create time (see item.service.ts). These are
// deliberately bare account-id strings (no Account relation), matching the
// existing convention for Item.mainAccountId / Customer.accountId elsewhere
// in this schema — resolved by id lookup in service code, not via Prisma
// include.
model ItemCategory {
  id                        String   @id @default(uuid())
  companyId                 String
  code                      String?
  arabicName                String
  englishName               String?
  groupType                 String?  @db.VarChar(20)
  parentCategoryId          String?
  isFeatured                Boolean  @default(false)
  isTaxExempt               Boolean  @default(false)
  taxRate                   Decimal? @db.Decimal(5, 2)
  defaultInventoryAccountId String?
  defaultSalesAccountId     String?
  defaultCogsAccountId      String?
  isActive                  Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parentCategory ItemCategory?  @relation("ItemCategoryParent", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  childCategories ItemCategory[] @relation("ItemCategoryParent")
  items          Item[]
  contractGroups CustomerContractGroup[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, isActive])
  @@index([parentCategoryId])
  @@map("item_categories")
}

model Item {
  id                   String   @id @default(uuid())
  companyId            String
  serial               String?
  arabicName           String
  englishName          String?
  mainAccountId        String?
  costCenterId         String?
  specifications       String?  @db.Text
  itemType             String? // normal/pack-sheet/pack-kilo/roll
  weight               Decimal? @db.Decimal(10, 3)
  // Sales Invoice Enterprise Redesign: category-driven GL defaulting +
  // barcode lookup + per-item tax profile defaults consumed by the sales
  // invoice line grid (still fully editable per line, not enforced).
  categoryId           String?
  barcode              String?
  salesAccountId       String?
  cogsAccountId        String?
  defaultTaxPercent    Decimal? @db.Decimal(5, 2)
  taxExemptionReason   String?
  // Properties
  manufacturerId       String?
  colorId              String?
  countryOfOrigin      String?
  quality              String?
  size                 String?
  property1            String?
  property2            String?
  property3            String?
  property4            String?
  property5            String?
  // Options
  useExpirationDate    Boolean  @default(false)
  inactiveItem         Boolean  @default(false)
  notSubjectToTerms    Boolean  @default(false)
  cannotBeReturned     Boolean  @default(false)
  noSellBelowCost      Boolean  @default(false)
  useSerialNumber      Boolean  @default(false)
  clothingItem         Boolean  @default(false)
  // Quantities
  upperLimit           Decimal? @db.Decimal(15, 3)
  orderLimit           Decimal? @db.Decimal(15, 3)
  orderLimitPercentage Decimal? @db.Decimal(5, 2)
  lowerLimit           Decimal? @db.Decimal(15, 3)
  beginningBalance     Decimal? @db.Decimal(15, 3)
  beginningCostPrice   Decimal? @db.Decimal(15, 2)
  priceRetail          Decimal  @default(0) @db.Decimal(18, 4)
  priceSemiWholesale   Decimal  @default(0) @db.Decimal(18, 4)
  priceWholesale       Decimal  @default(0) @db.Decimal(18, 4)
  priceProjects        Decimal  @default(0) @db.Decimal(18, 4)
  isService            Boolean  @default(false)
  isAssembly           Boolean  @default(false)
  isTaxExempt          Boolean  @default(false)
  consumerPrice        Decimal  @default(0) @db.Decimal(18, 4)
  retailPrice          Decimal  @default(0) @db.Decimal(18, 4)
  representativePrice  Decimal  @default(0) @db.Decimal(18, 4)
  exportPrice          Decimal  @default(0) @db.Decimal(18, 4)
  averageCost          Decimal  @default(0) @db.Decimal(18, 4)
  lastPurchasePrice    Decimal  @default(0) @db.Decimal(18, 4)
  priceMode            String?
  priceCurrency        String?
  extraAssemblyCost    Decimal? @db.Decimal(18, 4)
  extraAssemblyCostPct Decimal? @db.Decimal(18, 4)
  purchaseCount        Int?
  minPurchaseQty       Decimal? @db.Decimal(18, 4)
  assemblyComponents   Json?
  preferredSuppliers   Json?
  imageUrl             String?  @db.Text
  defaultWarehouseId   String?
  priceSource          String? // price_list | item_card
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company                    Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category                   ItemCategory?                 @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  units                      ItemUnit[]
  prices                     ItemPrice[]
  quantities                 ItemQuantity[]
  warehouseBalances          ItemWarehouseBalance[]
  invoiceLines               InvoiceLine[]
  electronicInvoiceItems     ElectronicInvoiceItem[]
  openingStockLines          OpeningStockLine[]
  stocktakingLines           StocktakingLine[]
  transferLines              TransferLine[]
  assembledItems             AssemblyLine[]                @relation("AssembledItem")
  componentItems             AssemblyComponent[]           @relation("ComponentItem")
  disassembledItems          DisassemblyLine[]             @relation("DisassembledItem")
  disassemblyComponents      DisassemblyComponent[]        @relation("DisassemblyComponentItem")
  receiptLines               ReceiptLine[]
  issueLines                 IssueLine[]
  adjustmentLines            AdjustmentLine[]
  otherAdjustmentLines       OtherAdjustmentLine[]
  purchaseReturnLines        PurchaseReturnLine[]
  priceQuoteLines            PriceQuoteLine[]
  itemOffersFrom             ItemOffer[]                   @relation("FromItem")
  itemOffersTo               ItemOffer[]                   @relation("ToItem")
  PurchaseOrderLine          PurchaseOrderLine[]
  costHistory                ItemCostHistory[]
  inventoryMovements         InventoryMovement[]
  personItemPrices           PersonItemPrice[]
  posOrderLines              PosOrderLine[]
  lcReceiptLines             LcReceiptLine[]
  bomAsFinished              BillOfMaterials[]             @relation("BomFinishedItem")
  bomAsRaw                   BomLine[]                     @relation("BomRawItem")
  productionFinished         ProductionOrder[]             @relation("ProductionFinishedItem")
  productionIssueLines       ProductionMaterialIssueLine[] @relation("ProductionIssueRawItem")
  landedCostAllocationLines  LandedCostAllocationLine[]
  materialReconciliationLogs MaterialReconciliationLog[]
  commissionQuantityLines    RepresentativeCommissionQuantity[]
  orderLimitLines            ItemOrderLimitLine[]

  @@index([companyId])
  @@index([serial])
  // Wave 4 fix: reconciles idx_items_company_active, created directly by
  // a raw-SQL migration but never declared here.
  @@index([companyId, isActive])
  @@index([categoryId])
  @@index([companyId, barcode])
  @@index([defaultWarehouseId])
  @@fulltext([arabicName, serial, barcode], map: "items_ft_lookup")
  @@map("items")
}

// Item Units
model ItemUnit {
  id               String  @id @default(uuid())
  itemId           String
  unitId           String
  /// معامل التحويل بالنسبة للوحدة الأساسية (factor).
  conversionFactor Decimal @default(1) @db.Decimal(15, 6)
  /// true = ثابت لكل حركة؛ false = يُحدَّد يدوياً من كمية الوحدة الأساسية (أوزان/أقمشة/رولات).
  isFactorFixed    Boolean @default(true)
  isBaseUnit       Boolean @default(false)

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unit Unit @relation(fields: [unitId], references: [id])

  @@unique([itemId, unitId])
  @@map("item_units")
}

// Price Lists
model PriceList {
  id                 String   @id @default(uuid())
  companyId          String
  code               String?
  arabicName         String
  englishName        String?
  description        String?
  discountPercentage Decimal? @db.Decimal(5, 2)
  currencyCode       String?
  priceMode          String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  prices     ItemPrice[]
  newModules NewModule[]

  @@unique([companyId, code])
  @@map("price_lists")
}

// Item Prices
model ItemPrice {
  id          String  @id @default(uuid())
  itemId      String
  priceListId String
  unitId      String
  price       Decimal @db.Decimal(15, 2)
  discount          Decimal? @db.Decimal(8, 4)
  wholesale         Decimal? @db.Decimal(18, 4)
  semiWholesale     Decimal? @db.Decimal(18, 4)
  exportPrice       Decimal? @db.Decimal(18, 4)
  representativePrice Decimal? @db.Decimal(18, 4)
  retailPrice       Decimal? @db.Decimal(18, 4)
  consumerPrice     Decimal? @db.Decimal(18, 4)

  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  unit      Unit      @relation(fields: [unitId], references: [id])

  @@unique([itemId, priceListId, unitId])
  @@map("item_prices")
}

// Warehouses
model Warehouse {
  id              String   @id @default(uuid())
  companyId       String
  code            String?
  legacyStoreCode String?  @db.VarChar(20)
  arabicName      String
  englishName     String?
  branchId        String?
  storeType       String?  @db.VarChar(20)
  parentWarehouseId String?
  inventoryAccountId String?
  costAccountId      String?
  giftAccountId      String?
  address         String?  @db.VarChar(255)
  keeperName      String?  @db.VarChar(191)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company                  Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch                   Branch?                @relation(fields: [branchId], references: [id])
  parentWarehouse          Warehouse?             @relation("WarehouseParent", fields: [parentWarehouseId], references: [id], onDelete: SetNull)
  childWarehouses          Warehouse[]            @relation("WarehouseParent")
  inventoryAccount         Account?               @relation("WarehouseInventoryAccount", fields: [inventoryAccountId], references: [id], onDelete: SetNull)
  costAccount              Account?               @relation("WarehouseCostAccount", fields: [costAccountId], references: [id], onDelete: SetNull)
  giftAccount              Account?               @relation("WarehouseGiftAccount", fields: [giftAccountId], references: [id], onDelete: SetNull)
  branchesDefaultFor       Branch[]               @relation("BranchDefaultWarehouse")
  locations                Location[]
  quantities               ItemQuantity[]
  warehouseBalances        ItemWarehouseBalance[]
  invoices                 Invoice[]
  openingStockLines        OpeningStockLine[]
  stocktaking              Stocktaking[]
  stocktakingLines         StocktakingLine[]
  transfersFrom            Transfer[]             @relation("TransferFrom")
  transfersTo              Transfer[]             @relation("TransferTo")
  assemblies               Assembly[]
  disassemblies            Disassembly[]
  receipts                 Receipt[]
  issues                   Issue[]
  adjustments              Adjustment[]
  otherAdjustments         OtherAdjustment[]
  purchaseOrders           PurchaseOrder[]
  purchaseReturns          PurchaseReturn[]
  priceQuotes              PriceQuote[]
  inventoryMovements       InventoryMovement[]
  newModuleStores          NewModuleStore[]
  posTerminals             PosTerminal[]
  lettersOfCredit          LetterOfCredit[]
  productionOrdersRaw      ProductionOrder[]      @relation("ProductionRawWarehouse")
  productionOrdersFinished ProductionOrder[]      @relation("ProductionFinishedWarehouse")
  invoiceLines             InvoiceLine[]
  documentProfiles         DocumentProfile[] @relation("DocumentProfileWarehouse")
  transactionSettings      TransactionSettings[]
  itemOrderLimitLists      ItemOrderLimitList[]

  @@index([companyId])
  @@index([code])
  @@index([parentWarehouseId])
  @@index([inventoryAccountId])
  @@index([costAccountId])
  @@index([giftAccountId])
  @@map("warehouses")
}

// Locations
model Location {
  id          String   @id @default(uuid())
  warehouseId String
  code        String?
  arabicName  String
  englishName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  warehouse            Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantities           ItemQuantity[]
  openingStockLines    OpeningStockLine[]
  stocktakingLines     StocktakingLine[]
  transferLinesFrom    TransferLine[]        @relation("TransferFromLocation")
  transferLinesTo      TransferLine[]        @relation("TransferToLocation")
  receiptLines         ReceiptLine[]
  issueLines           IssueLine[]
  adjustmentLines      AdjustmentLine[]
  otherAdjustmentLines OtherAdjustmentLine[]
  PurchaseReturnLine   PurchaseReturnLine[]
  inventoryMovements   InventoryMovement[]

  @@index([warehouseId])
  @@map("locations")
}

// Item Quantities
model ItemQuantity {
  id          String  @id @default(uuid())
  itemId      String
  warehouseId String
  locationId  String?
  quantity    Decimal @default(0) @db.Decimal(15, 3)

  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  location  Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([itemId, warehouseId, locationId])
  @@index([itemId, warehouseId])
  @@map("item_quantities")
}

model ItemOrderLimitList {
  id          String   @id @default(uuid())
  companyId   String
  code        String?
  warehouseId String
  description String?  @db.Text
