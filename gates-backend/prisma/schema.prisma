  company                 Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent                  Account?               @relation("AccountHierarchy", fields: [parentId], references: [id])
  children                Account[]              @relation("AccountHierarchy")
  defaultCostCenter       CostCenter?            @relation("AccountDefaultCostCenter", fields: [defaultCostCenterId], references: [id], onDelete: SetNull)
  journalEntryLines       JournalEntryLine[]
  recurringJournalLines   RecurringJournalLine[]
  costCenterMovements     CostCenterMovement[]
  customerMainAccounts    Customer[]             @relation("CustomerMainAccount")
  supplierMainAccounts    Supplier[]             @relation("SupplierMainAccount")
  personMainAccounts      Person[]               @relation("PersonMainAccount")
  employeeAdvanceAccounts Employee[]             @relation("EmployeeAdvanceAccount")
  treasuryReceipts        TreasuryReceipt[]
  treasuryPayments        TreasuryPayment[]
  safesAsGl               Safe[]
  bankAccountsAsGl        BankAccount[]
  cashTransactionOffsets         CashTransaction[]
  cashTransactionLines           CashTransactionLine[]
  multiCollectionLines           MultiCollectionLine[]
  landedCostAllocations          LandedCostAllocation[]
  accountPeriodBalances          AccountPeriodBalance[]
  companySettingsRounding        CompanySettings[]      @relation("CompanySettingsRoundingAccount")
  companySettingsExchange        CompanySettings[]      @relation("CompanySettingsExchangeAccount")
  invoiceLineRevenueAccounts     InvoiceLine[]          @relation("InvoiceLineRevenueAccount")
  invoiceAdjustmentAccounts      InvoiceAdjustment[]    @relation("AdjustmentAccount")
  invoiceAdjustmentOffsetAccounts InvoiceAdjustment[]   @relation("AdjustmentOffsetAccount")
  transactionSettingsSales            TransactionSettings[]  @relation("SettingsSalesAccount")
  transactionSettingsPurchaseReturns  TransactionSettings[]  @relation("SettingsPurchaseReturnAccount")
  transactionSettingsCash             TransactionSettings[]  @relation("SettingsCashAccount")
  transactionSettingsBankGl           TransactionSettings[]  @relation("SettingsBankGlAccount")
  transactionSettingsOffset           TransactionSettings[]  @relation("SettingsOffsetAccount")
  transactionSettingsCharges          TransactionSettings[]  @relation("SettingsChargesAccount")
  warehouseInventoryAccounts Warehouse[] @relation("WarehouseInventoryAccount")
  warehouseCostAccounts      Warehouse[] @relation("WarehouseCostAccount")
  warehouseGiftAccounts      Warehouse[] @relation("WarehouseGiftAccount")

  @@unique([companyId, code])
  @@index([companyId])
  @@index([defaultCostCenterId])
  // Wave 4 fix: reconciles idx_accounts_company_active, created directly
  // by a raw-SQL migration but never declared here.
  @@index([companyId, isActive])
  @@map("accounts")
}

enum AccountKind {
  HEADER
  POSTING
}

enum AccountNature {
  DEBIT
  CREDIT
}

enum StatementType {
  BALANCE_SHEET
  INCOME_STATEMENT
}

// Cost Centers
model CostCenter {
  id             String   @id @default(uuid())
  companyId      String
  code           String
  arabicName     String
  englishName    String?
  parentId       String?  @db.Char(36)
  /// HEADER = رئيسي / رئيسي فرعي (يُفرَّع منه فقط). POSTING = مركز حركة.
  costCenterKind AccountKind @default(POSTING)
  quantityBudget Decimal? @db.Decimal(15, 2)
  warning        String? // مدين/دائن/بدون
  budget         Decimal? @db.Decimal(15, 2)
  creditLimit    Decimal? @db.Decimal(18, 4)
  currencyCode   String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent              CostCenter?          @relation("CostCenterHierarchy", fields: [parentId], references: [id])
  children            CostCenter[]         @relation("CostCenterHierarchy")
  movements           CostCenterMovement[]
  journalEntryLines   JournalEntryLine[]
  recurringJournalLines RecurringJournalLine[]
  cashTransactionLines CashTransactionLine[]
  invoices            Invoice[]
  purchaseOrders      PurchaseOrder[]
  transfersFrom       Transfer[]           @relation("TransferFromCC")
  transfersTo         Transfer[]           @relation("TransferToCC")
  PurchaseReturn      PurchaseReturn[]
  PriceQuote          PriceQuote[]
  EmployeeContract    EmployeeContract[]
  employees           Employee[]
  contractingProjects ContractingProject[]
  realEstateProjects  RealEstateProject[]
  propertyProjects    PropertyProject[]
  academicGrades      AcademicGrade[]
  invoiceLines        InvoiceLine[]
  invoiceAdjustments  InvoiceAdjustment[]
  documentProfiles    DocumentProfile[]
  transactionSettings TransactionSettings[]
  accountsAsDefault   Account[]             @relation("AccountDefaultCostCenter")

  @@unique([companyId, code])
  @@index([companyId, parentId])
  @@index([companyId, costCenterKind])
  @@map("cost_centers")
}

// Cost Center Movements
model CostCenterMovement {
  id           String   @id @default(uuid())
  companyId    String
  accountId    String
  costCenterId String
  date         DateTime
  // M12 fix (Item 40): was Decimal(15,2) — two decimal places fewer than
  // `JournalEntryLine.debit`/`credit` (Decimal(18,4)), which this table's
  // rows are meant to mirror per cost center. Reports that join/reconcile
  // this table against journal-entry-line totals (see
  // `cost-center-movement.service.ts` / `reports.service.ts`) were
  // comparing a value truncated to 2 decimals against one carried to 4,
  // producing spurious rounding drift on the join. Widened to match; this
  // is a widening ALTER (safe/non-lossy — no existing value can overflow
  // or need truncation).
  debit        Decimal  @default(0) @db.Decimal(18, 4)
  credit       Decimal  @default(0) @db.Decimal(18, 4)
  description  String?
  createdAt    DateTime @default(now())

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account    Account    @relation(fields: [accountId], references: [id])
  costCenter CostCenter @relation(fields: [costCenterId], references: [id])

  @@index([companyId, date])
  @@index([accountId])
  @@index([costCenterId])
  @@map("cost_center_movements")
}

/// Display origin of a journal entry. Auto-GL still writes short codes
/// (`SI`, `PI`, `CR`, …) into `JournalEntry.sourceType` for idempotency.
enum JournalSourceType {
  MANUAL
  RECURRING_TEMPLATE
  SALES_INVOICE
  SALES_RETURN
  PURCHASE_INVOICE
  PURCHASE_RETURN
  PAYMENT_VOUCHER
  RECEIPT_VOUCHER
  STOCK_TRANSACTION
  DEPRECIATION
  CHEQUE_ENDORSEMENT
  CLOSING_ENTRY
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

// Journal Entries
model JournalEntry {
  id           String  @id @default(uuid())
  companyId    String
  branchId     String?
  fiscalYearId String?

  /// Legacy GLNum — 8-digit zero-padded string
  legacyGlNum   String? @db.VarChar(8)
  voucherNumber String?

  date          DateTime
  hijriDate     String?
  descriptionAr String?  @db.Text
  descriptionEn String?  @db.Text
  description   String?

  currencyCode String  @db.VarChar(10)
  exchangeRate Decimal @default(1) @db.Decimal(18, 6)

  /// Legacy Status: UnPost | Post
  postingStatus           String    @default("UnPost") @db.VarChar(10)
  /// Legacy header workflow: Open | …
  documentStatus          String    @default("Open") @db.VarChar(20)
  /// DRAFT | PENDING_APPROVAL | APPROVED | REJECTED | POSTED
  workflowStatus          String    @default("DRAFT") @db.VarChar(30)
  workflowSubmittedAt     DateTime?
  workflowSubmittedBy     String?
  workflowApprovedAt      DateTime?
  workflowApprovedBy      String?
  workflowRejectedAt      DateTime?
  workflowRejectedBy      String?
  workflowRejectionReason String?   @db.Text
  isBalanced              Boolean   @default(true)
  isPosted                Boolean   @default(false)
  isApproved              Boolean   @default(false)
  isCyclic                Boolean   @default(false)
  isRecurring             Boolean   @default(false)
  isCancelled             Boolean   @default(false)

  /// Auto-GL short code (SI, PI, CR, …). Do not replace with the display enum —
  /// `activeSourceKey` and posting idempotency are keyed on these codes.
  sourceType   String? @db.VarChar(20)
  sourceNumber String? @db.VarChar(30)
  sourceYearId String? @db.VarChar(20)
  /// UUID of the originating document (invoice, voucher, cheque, extract, …).
  sourceId     String? @db.VarChar(80)
  /// Display / API origin of the journal entry (manual, invoice, voucher, …).
  sourceKind   JournalSourceType @default(MANUAL)
  entryType    String? @db.VarChar(20)

  /// H2 fix: `${companyId}|${sourceType}|${sourceNumber}|${sourceYearId}` while
  /// this JE is the single *active* (posted, non-cancelled, non-deleted) entry
  /// for that source document; set back to NULL when unposted/cancelled/deleted
  /// so historical rows never collide. MySQL allows unlimited NULLs in a unique
  /// index, so this gives real concurrency-safe idempotency without blocking
  /// legitimate post → unpost → post lifecycles. Populated by
  /// journal-posting.service.ts; never set directly elsewhere.
  activeSourceKey String? @db.VarChar(120)

  /// C11 fix: a posted entry is never rewritten or flag-flipped back to
  /// "unposted" — it is neutralized by a dated contra entry that references
  /// it here, so both remain permanently visible in the ledger and the
  /// reversal itself is an auditable fact. Populated by
  /// journalPostingService.reverseJournalEntry(); one-to-one (a JE can be
  /// reversed at most once — reversing a reversal means re-posting instead).
  reversalOfJournalEntryId String? @unique

  postedAt  DateTime?
  postedBy  String?
  deletedAt DateTime?

  /// M14 fix (Item 40): optimistic-locking counter — draft edits were
  /// last-write-wins with nothing to detect two users editing the same
  /// unposted journal entry concurrently. Incremented on every draft
  /// update in `journalPostingService.updateJournalEntry()`; callers may
  /// pass `expectedVersion` to have a stale edit rejected with 409 instead
  /// of silently overwritten.
  version Int @default(0)

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // H14 fix: posted GL history must never cascade-delete with its company.
  // The application already soft-deletes companies (isActive: false); this
  // constraint is the DB-level backstop against a hard delete anywhere
  // (scripts, maintenance tooling, future code) silently destroying the ledger.
  company                   Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch                    Branch?                    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  fiscalYear                FiscalYear?                @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  lines                     JournalEntryLine[]
  violations                GlPostingViolation[]
  treasuryReceipts          TreasuryReceipt[]
  treasuryPayments          TreasuryPayment[]
  cashTransactions          CashTransaction[]
  chequePortfolio           Cheque[]                   @relation("ChequePortfolioJe")
  chequeDeposit             Cheque[]                   @relation("ChequeDepositJe")
  chequeClear               Cheque[]                   @relation("ChequeClearJe")
  chequeIssue               Cheque[]                   @relation("ChequeIssueJe")
  chequeCancel              Cheque[]                   @relation("ChequeCancelJe")
  chequeEndorse             Cheque[]                   @relation("ChequeEndorseJe")
  chequeBounce              Cheque[]                   @relation("ChequeBounceJe")
  taxDeclarations           TaxDeclaration[]
  taxSettlements            TaxSettlement[]
  posShiftEndOfDay          PosShift[]                 @relation("PosShiftEndJe")
  posOrders                 PosOrder[]                 @relation("PosOrderJournalEntry")
  invoiceAsPrimary          Invoice[]                  @relation("InvoiceJournalEntry")
  invoiceAsCost             Invoice[]                  @relation("InvoiceCostJournalEntry")
  stockIssues               Issue[]                    @relation("IssueJournalEntry")
  stockReceipts             Receipt[]                  @relation("ReceiptJournalEntry")
  stockTransfers            Transfer[]                 @relation("TransferJournalEntry")
  stockAdjustments          Adjustment[]               @relation("AdjustmentJournalEntry")
  stocktakings              Stocktaking[]              @relation("StocktakingJournalEntry")
  openingStocksAsJournal    OpeningStock[]             @relation("OpeningStockJournalEntry")
  counterpartyOffsets       CounterpartyOffset[]
  subcontractInvoices       SubcontractInvoice[]
  clientInvoices            ClientInvoice[]
  projectLettersOfGuarantee ProjectLetterOfGuarantee[]
  postDatedCheques          PostDatedCheque[]
  adjustmentNotesPosted     FinancialAdjustmentNote[]  @relation("AdjustmentNoteJournal")
  adjustmentNotesReversed   FinancialAdjustmentNote[]  @relation("AdjustmentNoteReversalOf")

  reversalOf JournalEntry? @relation("JournalEntryReversal", fields: [reversalOfJournalEntryId], references: [id], onDelete: Restrict)
  reversedBy JournalEntry? @relation("JournalEntryReversal")

  @@unique([companyId, branchId, fiscalYearId, legacyGlNum])
  @@unique([activeSourceKey])
  @@index([companyId, sourceType, sourceId])
  @@index([companyId, sourceKind])
  @@index([companyId, date])
  @@index([companyId, fiscalYearId, isPosted, date])
  @@index([companyId, postingStatus])
  @@index([voucherNumber])
  // Wave 4 fix: this index was created directly by a raw-SQL migration
  // (idx_journal_entries_company_status) but never declared here, so
  // `prisma migrate diff` against this schema would see it as drift and
  // could generate a migration to drop a real, in-use index.
  @@index([companyId, isPosted, isApproved])
  @@index([companyId, isPosted, date(sort: Desc)], map: "idx_journal_entries_company_posted_date")
  @@map("journal_entries")
}

model JournalEntryLine {
  id             String  @id @default(uuid())
  journalEntryId String
  lineNumber     Int
  accountId      String
  costCenterId   String?
  descriptionAr  String? @db.Text
  descriptionEn  String? @db.Text
  description    String?

  debit        Decimal @default(0) @db.Decimal(18, 4)
  credit       Decimal @default(0) @db.Decimal(18, 4)
  exchangeRate Decimal @default(1) @db.Decimal(18, 6)
  debitBase    Decimal @default(0) @db.Decimal(18, 4)
  creditBase   Decimal @default(0) @db.Decimal(18, 4)

  taxPercentCode String? @db.VarChar(20)
  lineOrder      Int

  /// Party on this line (shared AR/AP control accounts). Null on P&L/cash legs.
  partnerId   String?
  partnerType String? @db.VarChar(20)

  /// Optional AR/AP invoice linkage for this line (مقيد بفاتورة).
  isTiedToInvoice Boolean @default(false)
  invoiceId       String?
  invoiceNumber   String? @db.VarChar(50)

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])
  costCenter   CostCenter?  @relation(fields: [costCenterId], references: [id])
  invoice      Invoice?     @relation("JournalLineTiedInvoice", fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([journalEntryId, lineNumber])
  @@index([journalEntryId])
  @@index([accountId])
  @@index([accountId, journalEntryId])
  @@index([partnerId])
  @@index([invoiceId])
  @@map("journal_entry_lines")
}

model RecurringJournalEntry {
  id              String              @id @default(uuid())
  companyId       String
  templateNameAr  String
  frequency       RecurringFrequency  @default(MONTHLY)
  notes           String?
  totalAmount     Decimal             @db.Decimal(15, 2)
  isActive        Boolean             @default(true)
  lastGeneratedAt DateTime?

  lines RecurringJournalLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, isActive])
  @@map("recurring_journal_entries")
}

model RecurringJournalLine {
  id               String  @id @default(uuid())
  recurringEntryId String
  accountId        String
  costCenterId     String?
  description      String?
  debit            Decimal @default(0) @db.Decimal(15, 2)
  credit           Decimal @default(0) @db.Decimal(15, 2)

  recurringEntry RecurringJournalEntry @relation(fields: [recurringEntryId], references: [id], onDelete: Cascade)
  account        Account               @relation(fields: [accountId], references: [id])
  costCenter     CostCenter?           @relation(fields: [costCenterId], references: [id])

  @@index([recurringEntryId])
  @@map("recurring_journal_lines")
}

/// Pre-aggregated GL balances per calendar month. Updated atomically
/// inside the same transaction as journal post / reverse so Trial Balance
/// can read summaries instead of SUM() over journal_entry_lines.
model AccountPeriodBalance {
  id          String   @id @default(uuid())
  companyId   String
  accountId   String
  fiscalYear  Int
  periodMonth Int
  debitTotal  Decimal  @default(0) @db.Decimal(18, 4)
  creditTotal Decimal  @default(0) @db.Decimal(18, 4)
  netBalance  Decimal  @default(0) @db.Decimal(18, 4)
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([companyId, accountId, fiscalYear, periodMonth], map: "apb_company_account_period_key")
  @@index([companyId, fiscalYear, periodMonth])
  @@index([accountId])
  @@map("account_period_balances")
}

/// Running AR/AP totals per partner + document currency. Original and
/// company-base amounts are stored separately and must never be mixed.
model PartnerRunningBalance {
  id             String    @id @default(uuid())
  companyId      String
  partnerId      String
  partnerType    String    @db.VarChar(20)
  currencyCode   String    @db.VarChar(10)
  debitOriginal  Decimal   @default(0) @db.Decimal(18, 4)
  creditOriginal Decimal   @default(0) @db.Decimal(18, 4)
  netOriginal    Decimal   @default(0) @db.Decimal(18, 4)
  debitBase      Decimal   @default(0) @db.Decimal(18, 4)
  creditBase     Decimal   @default(0) @db.Decimal(18, 4)
  netBase        Decimal   @default(0) @db.Decimal(18, 4)
  lastEntryDate  DateTime?
  updatedAt      DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, partnerId, currencyCode])
  @@index([companyId])
  @@index([partnerId])
  @@index([companyId, partnerType])
  @@map("partner_running_balances")
}

model GlPostingViolation {
  id             String   @id @default(uuid())
  companyId      String
  journalEntryId String
  violationType  String   @db.VarChar(10)
  accountCode    String?  @db.VarChar(20)
  costCenterCode String?  @db.VarChar(20)
  message        String?  @db.Text
  createdAt      DateTime @default(now())

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  @@index([journalEntryId])
  @@map("gl_posting_violations")
}

enum PriceTier {
  RETAIL
  SEMI_WHOLESALE
  WHOLESALE
  PROJECTS
}

// Customers
model Customer {
  id                 String    @id @default(uuid())
  companyId          String
  serial             String?
  code               String?
  arabicName         String
  englishName        String?
  customerType       String? // company/individual
  how                String? // local/export/exempt
  nationality        String?
  taxData            Boolean   @default(false)
  taxAuthority       String?
  taxAuthorityName   String?
  // Contact fields
  phone1             String?
  phone2             String?
  mobile             String?
  fax                String?
  email              String?
  website            String?
  // Address fields
  country            String?
  city               String?
  area               String?
  street             String?
  postalCode         String?
  poBox              String?
  // Accounts
  mainAccountId      String?
  accountId          String?
  representativeId   String?
  priceListId        String?
  priceTier          PriceTier @default(RETAIL)
  linkedSupplierId   String?   @unique
  // Settings
  sellingPrice       String?
  transactionType    String?
  warning            String? // debtor/creditor
  estimatedBudget    Decimal?  @db.Decimal(15, 2)
  creditLimit        Decimal?  @db.Decimal(18, 4)
  /// H6 fix: credit terms in days, used to derive Invoice.dueDate when not
