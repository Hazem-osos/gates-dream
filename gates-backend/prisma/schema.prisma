  companyResponsibility  Decimal?  @db.Decimal(15, 2)
  leaveBalance           Decimal?  @db.Decimal(10, 2)
  departmentId           String?
  sectionId              String?
  jobCadreId             String?
  jobTitleId             String?
  cityId                 String?
