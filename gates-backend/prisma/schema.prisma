  subcontract               Subcontract?               @relation(fields: [subcontractId], references: [id], onDelete: Restrict)
  subcontractInvoice        SubcontractInvoice?        @relation(fields: [subcontractInvoiceId], references: [id], onDelete: Restrict)
  sitePenalty               SitePenaltyAndSnag?        @relation(fields: [sitePenaltyId], references: [id], onDelete: Restrict)
  materialReconciliation    MaterialReconciliationLog? @relation(fields: [materialReconciliationId], references: [id], onDelete: Restrict)
  executiveMeasurementSheet ExecutiveMeasurementSheet? @relation(fields: [executiveMeasurementSheetId], references: [id], onDelete: Restrict)
  clientContract            ClientContract?            @relation(fields: [clientContractId], references: [id], onDelete: Restrict)
