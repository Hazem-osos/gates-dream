model TradeSettings {
  id                            String   @id @default(uuid())
  companyId                     String   @unique
  openLcWipAccountCode          String?  @db.VarChar(20)
  inventoryAccountCode          String?  @db.VarChar(20)
  lcPayableAccountCode          String?  @db.VarChar(20)
  lgCashCoverAccountCode        String?  @db.VarChar(20)
  bankCommissionAccountCode     String?  @db.VarChar(20)
  lgConfiscationLossAccountCode String?  @db.VarChar(20)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("trade_settings")
}

model LetterOfCredit {
  id                     String    @id @default(uuid())
  companyId              String
  branchId               String?
  fiscalYearId           String?
  sourceYearId           String?   @db.VarChar(20)
  lcNumber               String
  supplierId             String?
  bankAccountId          String?
  warehouseId            String?
  currencyCode           String    @default("EGP") @db.VarChar(10)
  exchangeRate           Decimal   @default(1) @db.Decimal(18, 6)
  totalAmountFx          Decimal   @db.Decimal(15, 2)
  merchandiseBase        Decimal   @default(0) @db.Decimal(15, 2)
  totalLandedCost        Decimal   @default(0) @db.Decimal(15, 2)
  /// OPEN | RECEIVED | CLOSED
  status                 String    @default("OPEN") @db.VarChar(20)
  expiryDate             DateTime?
  openingJournalEntryId  String?
  clearingJournalEntryId String?
  issueDate              DateTime  @default(now())
  clearedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch       Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  fiscalYear   FiscalYear?     @relation(fields: [fiscalYearId], references: [id], onDelete: SetNull)
  supplier     Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  bankAccount  BankAccount?    @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  warehouse    Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  expenses     LcExpense[]
  receiptLines LcReceiptLine[]

  @@unique([companyId, lcNumber])
  @@index([companyId, status])
  @@map("letter_of_credits")
}

model LcExpense {
  id             String   @id @default(uuid())
  companyId      String
  lcId           String
  expenseType    String   @db.VarChar(40)
  description    String?
  amount         Decimal  @db.Decimal(15, 2)
  currencyCode   String   @default("EGP") @db.VarChar(10)
  exchangeRate   Decimal  @default(1) @db.Decimal(18, 6)
  amountBase     Decimal  @db.Decimal(15, 2)
  expenseDate    DateTime @default(now())
  journalEntryId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lc LetterOfCredit @relation(fields: [lcId], references: [id], onDelete: Cascade)

  @@index([lcId])
  @@index([companyId])
  @@map("lc_expenses")
}

model LcReceiptLine {
  id                   String   @id @default(uuid())
  lcId                 String
  itemId               String
  unitId               String?
  quantity             Decimal  @db.Decimal(15, 4)
  merchandiseBase      Decimal  @db.Decimal(15, 2)
  allocatedExpenseBase Decimal  @default(0) @db.Decimal(15, 2)
  landedUnitCostBase   Decimal  @db.Decimal(15, 4)
  lineOrder            Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  lc   LetterOfCredit @relation(fields: [lcId], references: [id], onDelete: Cascade)
  item Item           @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([lcId])
  @@map("lc_receipt_lines")
}

/// Wave 2 bank guarantee letters (M23); legacy `letters_of_guarantee` remains for import-export UI.
model GuaranteeLetter {
  id                       String    @id @default(uuid())
  companyId                String
  branchId                 String?
  fiscalYearId             String?
  sourceYearId             String?   @db.VarChar(20)
  lgNumber                 String
  /// BID_BOND | PERFORMANCE | ADVANCE_PAYMENT
  lgType                   String    @db.VarChar(30)
  bankAccountId            String?
  beneficiaryName          String?
  amount                   Decimal   @db.Decimal(15, 2)
  cashCoverAmount          Decimal   @default(0) @db.Decimal(15, 2)
  commissionAmount         Decimal   @default(0) @db.Decimal(15, 2)
  currencyCode             String    @default("EGP") @db.VarChar(10)
  issueDate                DateTime
  expiryDate               DateTime?
  /// ACTIVE | EXTENDED | RELEASED | CONFISCATED
  status                   String    @default("ACTIVE") @db.VarChar(20)
  issueJournalEntryId      String?
  releaseJournalEntryId    String?
  confiscateJournalEntryId String?
  extendedAt               DateTime?
  releasedAt               DateTime?
  createdAt                DateTime  @default(now())
