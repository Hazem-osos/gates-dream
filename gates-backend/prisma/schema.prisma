  cashCollectionPapers3 String? // أوراق القبض النقدية 3
  approvalStatus        String    @default("closed") // 'open' | 'closed'
  entryId               String? // Reference to JournalEntry
  closingEntryId        String? // Reference to JournalEntry
  creationEntryId       String? // Reference to JournalEntry
  // Dates (10 date fields as seen in frontend)
  date1                 DateTime?
  date1Hijri            String?
  date2                 DateTime?
  date2Hijri            String?
  date3                 DateTime?
  date3Hijri            String?
  date4                 DateTime?
  date4Hijri            String?
  date5                 DateTime?
  date5Hijri            String?
  date6                 DateTime?
  date6Hijri            String?
  date7                 DateTime?
  date7Hijri            String?
  date8                 DateTime?
  date8Hijri            String?
  date9                 DateTime?
  date9Hijri            String?
  date10                DateTime?
  date10Hijri           String?
  // Renewal tracking
  isRenewed             Boolean   @default(false)
  renewedFromId         String? // Reference to previous letter
  renewedAt             DateTime?
  isActive              Boolean   @default(true)
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  renewedFrom LetterOfGuarantee?  @relation("LetterRenewals", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewedTo   LetterOfGuarantee[] @relation("LetterRenewals")

  @@index([companyId])
  @@index([serial])
  @@index([letterType])
  @@index([approvalStatus])
  @@index([expiryDate])
  @@index([renewedFromId])
  @@map("letters_of_guarantee")
}

// ============================================
// M7 — TAXES / DARIBA
// ============================================

/// DaribaPeriod — VAT / WHT declaration window
model TaxPeriod {
  id           String    @id @default(uuid())
  companyId    String
  branchId     String?
  fiscalYearId String
  periodNumber Int
  periodName   String?
  /// MONTHLY | QUARTERLY
  periodType   String    @default("MONTHLY") @db.VarChar(20)
  sourceYearId String?   @db.VarChar(20)
  startDate    DateTime
  endDate      DateTime
  /// OPEN | CLOSED
  status       String    @default("OPEN") @db.VarChar(10)
  closedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch       Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  fiscalYear   FiscalYear       @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  declarations TaxDeclaration[]

  @@unique([companyId, fiscalYearId, periodNumber])
  @@index([companyId, startDate, endDate])
  @@index([companyId, status])
  @@map("tax_periods")
}

model TaxDeclaration {
  id                       String   @id @default(uuid())
  companyId                String
  taxPeriodId              String
  fiscalYearId             String?
  totalOutputVat           Decimal  @default(0) @db.Decimal(15, 2)
  totalInputVat            Decimal  @default(0) @db.Decimal(15, 2)
  netVatAmount             Decimal  @default(0) @db.Decimal(15, 2)
  totalWithholdingTax      Decimal  @default(0) @db.Decimal(15, 2)
  /// DRAFT | FINAL | SETTLED
  status                   String   @default("DRAFT") @db.VarChar(20)
  settlementJournalEntryId String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  company                Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taxPeriod              TaxPeriod       @relation(fields: [taxPeriodId], references: [id], onDelete: Cascade)
  fiscalYear             FiscalYear?     @relation(fields: [fiscalYearId], references: [id], onDelete: SetNull)
  settlementJournalEntry JournalEntry?   @relation(fields: [settlementJournalEntryId], references: [id], onDelete: SetNull)
  settlements            TaxSettlement[]

  @@unique([companyId, taxPeriodId])
  @@map("tax_declarations")
}

model TaxSettlement {
  id                    String    @id @default(uuid())
  companyId             String
  taxDeclarationId      String
  amount                Decimal   @db.Decimal(15, 2)
  currencyCode          String    @default("EGP")
  /// PAYMENT to authority via treasury
  paymentJournalEntryId String?
  safeId                String?
  bankAccountId         String?
  settledAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  company             Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taxDeclaration      TaxDeclaration @relation(fields: [taxDeclarationId], references: [id], onDelete: Cascade)
  paymentJournalEntry JournalEntry?  @relation(fields: [paymentJournalEntryId], references: [id], onDelete: SetNull)

  @@index([companyId, taxDeclarationId])
  @@map("tax_settlements")
}

// ============================================
// M6 — POINT OF SALE (POS)
// ============================================

model PosTerminal {
  id                String   @id @default(uuid())
  companyId         String
  branchId          String
  warehouseId       String
  safeId            String
  bankAccountId     String?
  defaultCustomerId String?
  name              String
  deviceCode        String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch          Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  warehouse       Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  safe            Safe         @relation(fields: [safeId], references: [id], onDelete: Restrict)
  bankAccount     BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  defaultCustomer Customer?    @relation(fields: [defaultCustomerId], references: [id], onDelete: SetNull)
  shifts          PosShift[]

  @@unique([companyId, deviceCode])
  @@index([companyId, branchId])
  @@map("pos_terminals")
}

model PosShift {
  id                     String    @id @default(uuid())
  companyId              String
  branchId               String
  fiscalYearId           String?
  terminalId             String
  userId                 String
  shiftNumber            String?
  status                 String    @default("OPEN") @db.VarChar(10)
  openedAt               DateTime  @default(now())
  closedAt               DateTime?
  openingCash            Decimal   @default(0) @db.Decimal(15, 2)
  closingCashDeclared    Decimal?  @db.Decimal(15, 2)
  closingCashSystem      Decimal?  @db.Decimal(15, 2)
  cashVariance           Decimal?  @db.Decimal(15, 2)
  totalCashSales         Decimal   @default(0) @db.Decimal(15, 2)
  totalCardSales         Decimal   @default(0) @db.Decimal(15, 2)
  totalCreditSales       Decimal   @default(0) @db.Decimal(15, 2)
  totalMerchandise       Decimal   @default(0) @db.Decimal(15, 2)
  totalTaxAmount         Decimal   @default(0) @db.Decimal(15, 2)
  totalCogs              Decimal   @default(0) @db.Decimal(15, 2)
  endOfDayJournalEntryId String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  company              Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch               Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  fiscalYear           FiscalYear?   @relation(fields: [fiscalYearId], references: [id], onDelete: SetNull)
  terminal             PosTerminal   @relation(fields: [terminalId], references: [id], onDelete: Restrict)
  endOfDayJournalEntry JournalEntry? @relation("PosShiftEndJe", fields: [endOfDayJournalEntryId], references: [id], onDelete: SetNull)
  orders               PosOrder[]

  @@index([companyId, terminalId, status])
  @@map("pos_shifts")
}

model PosOrder {
  id              String    @id @default(uuid())
  companyId       String
  shiftId         String
  orderNumber     String
  orderType       String    @default("SALE") @db.VarChar(20)
  originalOrderId String?
  status          String    @default("DRAFT") @db.VarChar(20)
  customerId      String?
  barcodeRef      String?
  totalAmount     Decimal   @default(0) @db.Decimal(15, 2)
  discountAmount  Decimal   @default(0) @db.Decimal(15, 2)
  taxAmount       Decimal   @default(0) @db.Decimal(15, 2)
  netAmount       Decimal   @default(0) @db.Decimal(15, 2)
  cashAmount      Decimal   @default(0) @db.Decimal(15, 2)
  cardAmount      Decimal   @default(0) @db.Decimal(15, 2)
  creditAmount    Decimal   @default(0) @db.Decimal(15, 2)
  paymentMethod   String    @db.VarChar(20)
  currencyCode    String    @default("EGP")
  /// C10/H12 fix: each order now posts its own balanced journal at `postOrder`
  /// time instead of waiting for the shift to close, so revenue/VAT/COGS are
  /// in the GL immediately and a trial balance mid-shift is correct.
  journalEntryId  String?
  postedAt        DateTime?
  postedBy        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shift             PosShift           @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  customer          Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  originalOrder     PosOrder?          @relation("PosReturnLink", fields: [originalOrderId], references: [id], onDelete: SetNull)
  returns           PosOrder[]         @relation("PosReturnLink")
  journalEntry      JournalEntry?      @relation("PosOrderJournalEntry", fields: [journalEntryId], references: [id], onDelete: SetNull)
  lines             PosOrderLine[]
  eInvoiceDocuments EInvoiceDocument[]

  @@unique([companyId, orderNumber])
  @@index([shiftId, status])
  @@map("pos_orders")
}

model PosOrderLine {
  id              String   @id @default(uuid())
  orderId         String
  itemId          String
  unitId          String
  quantity        Decimal  @db.Decimal(15, 4)
  price           Decimal  @db.Decimal(15, 4)
  /// H12 fix: POS lines previously only accepted a flat discountAmount.
  discountPercent Decimal? @db.Decimal(5, 2)
  discountAmount  Decimal  @default(0) @db.Decimal(15, 2)
  taxPercent      Decimal  @default(0) @db.Decimal(8, 4)
  taxAmount       Decimal  @default(0) @db.Decimal(15, 2)
  lineTotal       Decimal  @default(0) @db.Decimal(15, 2)
  unitCost        Decimal  @default(0) @db.Decimal(15, 4)
  lineOrder       Int

  order PosOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item  Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  unit  Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("pos_order_lines")
}

