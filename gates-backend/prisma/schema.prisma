/// H9 fix — landed-cost capitalization. Freight/customs/insurance/handling
/// incurred to bring a PURCHASE invoice's goods into the warehouse are
/// initially recorded (e.g. paid to a customs broker) against
/// `expenseAccountId`; this document reallocates that already-recorded cost
/// out of the expense account and into the received items' inventory value
/// — proportional to each line's merchandise value — via a reclass journal
/// entry and a moving-average cost top-up (see
/// item-cost.service.ts#capitalizeAdditionalCostInTx). Never mutates the
/// original invoice or its cost history.
model LandedCostAllocation {
  id               String    @id @default(uuid())
  companyId        String
  branchId         String?
  invoiceId        String
  description      String?
  serial           String?
  date             DateTime
  hijriDate        String?
  totalAmount      Decimal   @db.Decimal(18, 4)
  expenseAccountId String
  record           String? // رقم القيد (Journal Entry Reference)
  isPosted         Boolean   @default(false)
  postedAt         DateTime?
  isCancelled      Boolean   @default(false)
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company        Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  invoice        Invoice                    @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  expenseAccount Account                    @relation(fields: [expenseAccountId], references: [id], onDelete: Restrict)
  lines          LandedCostAllocationLine[]

  @@index([companyId])
  @@index([invoiceId])
  @@map("landed_cost_allocations")
}

model LandedCostAllocationLine {
  id               String  @id @default(uuid())
  allocationId     String
  invoiceLineId    String
  itemId           String
  merchandiseValue Decimal @db.Decimal(18, 4) // this line's share of the invoice's merchandise value (the allocation base)
  allocatedAmount  Decimal @db.Decimal(18, 4) // landed cost allocated to this line
  quantity         Decimal @db.Decimal(18, 4) // snapshot of invoiceLine.baseQuantity at allocation time
  unitCostAdded    Decimal @db.Decimal(18, 4) // allocatedAmount / quantity — what got added to the item's average cost

  allocation  LandedCostAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  invoiceLine InvoiceLine          @relation(fields: [invoiceLineId], references: [id], onDelete: Cascade)
  item        Item                 @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([allocationId])
  @@index([invoiceLineId])
  @@map("landed_cost_allocation_lines")
}

