  status                       String    @default("DRAFT") @db.VarChar(20)
  totalMaterialCost            Decimal   @default(0) @db.Decimal(15, 2)
  totalLaborCost               Decimal   @default(0) @db.Decimal(15, 2)
  totalOverheadCost            Decimal   @default(0) @db.Decimal(15, 2)
