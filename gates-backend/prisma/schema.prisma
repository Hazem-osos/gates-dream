// ============================================
// MANUFACTURING MODULE
// ============================================

// Sensor Readings (Time-Series Data)
model SensorReading {
  id         String   @id @default(uuid()) @db.Char(36)
  // Wave 1 (zero-defect gap closure): this table had no companyId at all — sensor
  // ingestion/query only ever filtered by machineId, so any tenant able to name another
  // tenant's machineId could read its IoT data, and the Prisma tenant-scoping extension
  // (which requires a direct companyId column) provided no backstop. Nullable because
  // there is no Machine model linking machineId to a company to backfill existing rows
  // from; the ingestion/query service now always sets it for new rows, and legacy NULL
  // rows are simply invisible under any tenant filter (fail closed, not leaked).
  companyId  String?  @db.Char(36)
  machineId  String   @db.VarChar(255)
  sensorType String   @db.VarChar(255)
  value      Decimal  @db.Decimal(15, 4)
  unit       String?  @db.VarChar(50)
  timestamp  DateTime @db.DateTime(3)
  metadata   Json?
  createdAt  DateTime @default(now()) @db.DateTime(3)

  @@index([companyId, machineId, sensorType])
  @@index([timestamp])
  @@index([companyId, machineId, timestamp])
  @@map("sensor_readings")
}

