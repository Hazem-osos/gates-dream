generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex"]
  binaryTargets   = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// LEGACY MODELS (Kept for backward compatibility)
// These models use tenantId and are from the old schema
// ============================================

model Tenant {
  id        String       @id @default(uuid()) @db.Char(36)
  name      String
  locked    Boolean      @default(false)
  createdAt DateTime     @default(now())
  users     UserLegacy[]

  @@map("tenants")
}

model UserLegacy {
  id        String   @id @default(uuid()) @db.Char(36)
  tenantId  String   @db.Char(36)
  email     String
  role      String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users_legacy")
}

model RateLimit {
  id       String   @id @default(uuid()) @db.Char(36)
  tenantId String   @db.Char(36)
  userId   String?  @db.Char(36)
  key      String
  window   DateTime
  count    Int      @default(0)

  @@unique([tenantId, userId, key, window])
  @@index([tenantId, key])
  @@map("rate_limits")
}

// C12 fix (Item 38): the `AuditLog` model (`audit_logs` table, with
// tamper-evident `prevHash`/`rowHash` columns) that used to live here was
// never written by any application code — verified zero `auditLog.create`
// call sites across `src/`. It presented a hash-chain audit API with no
// data behind it, which is worse than not having the feature at all.
// Removed along with its API (`audit-log.routes.ts`) and the misleading
// trigger-migration comments in `0004_audit_triggers/migration.sql`.
// `audit-log.service.ts` now serves the same routes/response shape from
// `ActivityLog` below, which *is* actively written by
// `documentAuditService` (journal-entry/document lifecycle) and the
// security-event logger.

model ActivityLog {
  id             String   @id @default(uuid()) @db.Char(36)
  tenantId       String   @db.Char(36)
  actorId        String   @db.Char(36)
  kind           String
  subjectType    String
  subjectId      String
  severity       String
  reason         String?
  metadata       Json?
  at             DateTime @default(now())
  requestId      String?
  ip             String?
  userAgent      String?
  impersonatedBy String?

  @@index([tenantId, kind, at])
  @@map("activity_logs")
}

