/// Origin document that hydrated / converted into an invoice.
enum SourceDocumentType {
  QUOTATION
  SALES_ORDER
  PURCHASE_ORDER
  PURCHASE_INVOICE
  DELIVERY_NOTE
  NONE
}

// Invoices (Sales/Purchase)
model Invoice {
  id                      String             @id @default(uuid())
  companyId               String
  branchId                String?
  fiscalYearId            String?
  // H14/C7 fix: narrowed from unbounded VARCHAR(191) so the new
  // (companyId, branchId, fiscalYearId, invoiceType, invoiceNumber) unique
  // index fits MySQL's 3072-byte max key length (utf8mb4 = 4 bytes/char).
  invoiceNumber           String?            @db.VarChar(50)
  /// API kinds: PURCHASE | SALE | PURCHASE_RETURN | SALE_RETURN (legacy invoiceType still stored)
  invoiceKind             String?            @db.VarChar(30)
  invoiceType             String             @db.VarChar(20) // sales/purchase/return
  /// 4-char NewModule fullCode (SI01, SI02, …) — settings/numbering suffix.
  moduleCode              String?            @db.VarChar(4)
  newModuleId             String?
  date                    DateTime
  /// H6 fix: explicit due date for credit-term aging (Σ open items are aged
  /// from this, falling back to `date` when null for pre-existing rows).
  dueDate                 DateTime?
  hijriDate               String?
  description             String?            @db.Text
  currencyCode            String
  /// Legacy YearId for costing / source keys
  sourceYearId            String?            @db.VarChar(20)
  exchangeRate            Decimal            @default(1) @db.Decimal(18, 6)
  // Parties
  customerId              String?
  supplierId              String?
  warehouseId             String?
  costCenterId            String?
  representativeId        String?
  // Totals
  totalAmount             Decimal            @default(0) @db.Decimal(18, 4)
  /// M7 fix: total discount = Σ line discounts + the header discount below,
  /// proportionally allocated back onto each line (`InvoiceLine.headerDiscountAllocated`).
  discountAmount          Decimal            @default(0) @db.Decimal(18, 4)
  /// M7 fix: an additional whole-invoice discount on top of line discounts,
  /// applied to the post-line-discount subtotal and posted to the mapped
  /// `salesDiscount` GL account instead of being netted into revenue.
  headerDiscountPercent   Decimal?           @db.Decimal(5, 2)
  /// رسم تنمية: نسبة مئوية اختيارية (مثلاً 1–5٪) تُحسب على الصافي قبل الضريبة
  developmentFeeRate      Decimal?           @db.Decimal(5, 2)
  /// قيمة رسم التنمية المحسوبة على السيرفر (0 إذا لم يُفعَّل)
  developmentFeeAmount    Decimal            @default(0) @db.Decimal(18, 4)
  /// Snapshot of company pricing basis at save time.
  pricingCalculationBasis String?            @db.VarChar(30)
  taxAmount               Decimal            @default(0) @db.Decimal(18, 4)
  withholdingTaxAmount    Decimal            @default(0) @db.Decimal(18, 4)
  netAmount               Decimal            @default(0) @db.Decimal(18, 4)
  paidAmount              Decimal            @default(0) @db.Decimal(18, 4)
  remainingAmount         Decimal            @default(0) @db.Decimal(18, 4)
  /// UNPAID | PARTIALLY_PAID | PAID
  paymentStatus           String?            @db.VarChar(20)
  /// DRAFT | PENDING_APPROVAL | APPROVED | REJECTED | POSTED
  workflowStatus          String             @default("DRAFT") @db.VarChar(30)
  workflowSubmittedAt     DateTime?
  workflowSubmittedBy     String?
  workflowApprovedAt      DateTime?
  workflowApprovedBy      String?
  workflowRejectedAt      DateTime?
  workflowRejectedBy      String?
  workflowRejectionReason String?            @db.Text
  createdBy               String?
  // Status
  isPosted                Boolean            @default(false)
  postedAt                DateTime?
  postedBy                String?
  isApproved              Boolean            @default(false)
  isCancelled             Boolean            @default(false)
  isSalesTaxInvoice       Boolean            @default(false)
  allowReturn             Boolean            @default(false)
  returnDays              Int?
  /// Sales Invoice Enterprise Redesign: richer companion to `isSalesTaxInvoice`
  /// (taxable/exempt/export) — the UI keeps deriving `isSalesTaxInvoice` from
  /// this so the existing tax-calculation math is untouched.
  taxTreatmentType        String?            @db.VarChar(20)
  /// Delivery/handover tracking, surfaced in the header's advanced section.
  isDelivered             Boolean            @default(false)
  handoverDate            DateTime?
  // Payment
  paymentMethod           String? // cash/credit/split
  /// Multi-tender lines when paymentMethod = split (JSON array)
  paymentSplits           Json?
  /// Private staff notes — never exposed on print/public links
  internalNotes           Json?
  sellerId                String?
  currencyId              String?
  record                  String? // رقم القيد (Journal Entry Reference)
  journalEntryId          String?
  costJournalEntryId      String?
  /// Wave 3 fix: set when this draft ("sales order") has been converted into
  /// a real sale invoice via `SALES_ORDER_TO_SALE_INVOICE`, so the same
  /// draft can't be converted into an unbounded number of invoices.
  convertedInvoiceId      String?            @unique
  /// فاتورة المبيعات الأصلية التي يُردّ منها هذا المردود / إشعار الخصم
  originalInvoiceId       String?
  originalInvoiceNumber   String?            @db.VarChar(50)
  /// القسم والرقم — lineage of the quotation / order this invoice was pre-filled from.
  sourceType              SourceDocumentType @default(NONE)
  sourceId                String?
  sourceNumber            String?            @db.VarChar(80)
  // Electronic
  taxSignature            String?            @db.Text
  taxHash                 String?
  taxSubmitted            Boolean            @default(false)
  taxSubmissionId         String?
  eInvoiceDocuments       EInvoiceDocument[]
  /// Optimistic lock (Module 2 Invoice.version). Bumped on every draft save.
  version                 Int                @default(1)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch                Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  fiscalYear            FiscalYear?            @relation(fields: [fiscalYearId], references: [id], onDelete: SetNull)
  customer              Customer?              @relation(fields: [customerId], references: [id])
  supplier              Supplier?              @relation(fields: [supplierId], references: [id])
  warehouse             Warehouse?             @relation(fields: [warehouseId], references: [id])
  newModule             NewModule?             @relation(fields: [newModuleId], references: [id], onDelete: SetNull)
  documentProfileId     String?
  documentProfile       DocumentProfile?       @relation("InvoiceDocumentProfile", fields: [documentProfileId], references: [id], onDelete: SetNull)
  delegate              Delegate?              @relation(fields: [representativeId], references: [id])
  costCenter            CostCenter?            @relation(fields: [costCenterId], references: [id])
  currency              Currency?              @relation(fields: [currencyId], references: [id], onDelete: SetNull)
  journalEntry          JournalEntry?          @relation("InvoiceJournalEntry", fields: [journalEntryId], references: [id], onDelete: SetNull)
  costJournalEntry      JournalEntry?          @relation("InvoiceCostJournalEntry", fields: [costJournalEntryId], references: [id], onDelete: SetNull)
  lines                 InvoiceLine[]
  adjustments           InvoiceAdjustment[]
  conditions            InvoiceCondition[]
  settlements           CashTransaction[]      @relation("InvoiceSettlements")
  paymentAllocations    PaymentAllocation[]
  cashTransactionLines  CashTransactionLine[]
  tiedJournalLines      JournalEntryLine[]     @relation("JournalLineTiedInvoice")
  settlementCheques     Cheque[]
  purchaseOrder         PurchaseOrder?
  purchaseReturns       PurchaseReturn[]
  priceQuote            PriceQuote?            @relation
  landedCostAllocations LandedCostAllocation[]
  convertedInvoice      Invoice?               @relation("InvoiceConversionSource", fields: [convertedInvoiceId], references: [id], onDelete: SetNull)
  convertedFromInvoice  Invoice?               @relation("InvoiceConversionSource")
  originalInvoice       Invoice?               @relation("InvoiceReturns", fields: [originalInvoiceId], references: [id], onDelete: SetNull)
  returns               Invoice[]              @relation("InvoiceReturns")
  installments          InvoiceInstallment[]

  @@unique([companyId, branchId, fiscalYearId, invoiceType, invoiceNumber])
  @@index([companyId, date])
  @@index([invoiceNumber])
  @@index([invoiceType])
  @@index([companyId, branchId, isPosted, invoiceType, date])
  // Wave 4 fix: reconciles idx_invoices_company_status, created directly
  // by a raw-SQL migration but never declared here.
  @@index([companyId, isPosted, isApproved])
  // Wave 4 fix: AR aging (dueDate range scans) and open-balance listings
  // (remainingAmount > 0) were filtering/sorting on columns with no
  // supporting composite index, forcing a full companyId-index scan plus
  // filesort over every posted invoice for a tenant.
  @@index([companyId, isPosted, isCancelled, dueDate])
  @@index([companyId, invoiceKind, isPosted, isCancelled, remainingAmount])
  @@index([companyId, invoiceKind, isPosted, date(sort: Desc)], map: "idx_invoices_kind_posted_date")
  @@index([companyId, moduleCode])
  @@index([newModuleId])
  @@index([documentProfileId])
  @@index([companyId, sourceType, sourceId])
  @@index([originalInvoiceId])
  @@fulltext([invoiceNumber, record, description], map: "invoices_ft_lookup")
  @@map("invoices")
}

enum InvoiceInstallmentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

/// جدول أقساط الفاتورة — يُحفظ مع رأس الفاتورة في نفس الـ transaction.
model InvoiceInstallment {
  id                    String                    @id @default(uuid())
  invoiceId             String
  installmentNumber     Int
  dueDate               DateTime
  hijriDueDate          String?
  amount                Decimal                   @db.Decimal(18, 4)
  paidAmount            Decimal                   @default(0) @db.Decimal(18, 4)
  isPaid                Boolean                   @default(false)
  status                InvoiceInstallmentStatus  @default(PENDING)
  paymentDate           DateTime?
  notes                 String?                   @db.Text
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  invoice               Invoice                   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  cashTransactions      CashTransaction[]

  @@unique([invoiceId, installmentNumber])
  @@index([invoiceId, status])
  @@index([dueDate])
  @@index([status])
  @@map("invoice_installments")
}

enum AdjustmentType {
  ADDITION
  DEDUCTION
}

enum CalculationType {
  FIXED
  PERCENTAGE
}

/// إضافات وخصومات الفاتورة — بنود ديناميكية مربوطة بدليل الحسابات.
model InvoiceAdjustment {
  id              String          @id @default(uuid())
  companyId       String
  invoiceId       String
  type            AdjustmentType
  calcType        CalculationType @default(FIXED)
  rate            Decimal?        @db.Decimal(10, 2)
  amount          Decimal         @db.Decimal(18, 4)
  description     String?
  currency        String          @default("EGP")
  exchangeRate    Decimal?        @db.Decimal(18, 6)
  accountId       String
  offsetAccountId String?
  costCenterId    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice       Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  account       Account     @relation("AdjustmentAccount", fields: [accountId], references: [id])
  offsetAccount Account?    @relation("AdjustmentOffsetAccount", fields: [offsetAccountId], references: [id], onDelete: SetNull)
  costCenter    CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  @@index([companyId, invoiceId])
  @@index([invoiceId])
  @@index([accountId])
  @@index([offsetAccountId])
  @@index([costCenterId])
  @@map("invoice_adjustments")
}

enum DocumentBaseType {
  SALES_INVOICE
  PURCHASE_INVOICE
  PAYMENT_VOUCHER
  RECEIPT_VOUCHER
  STOCK_ISSUE
  STOCK_RECEIPT
  SALES_RETURN
  PURCHASE_RETURN
  BANK_DEBIT_ADVICE
  BANK_CREDIT_ADVICE
  JOURNAL_ENTRY
  OPENING_BALANCE
}

enum NumberingMode {
  AUTOMATIC
  MANUAL
}

enum SequenceMode {
  CONTINUOUS
  ANNUAL_RESET
}

enum PricingPolicy {
  COST
  LAST_PURCHASE
  LAST_SALE
  LAST_SALE_TO_CUSTOMER
}

enum CostCenterPostingSide {
  DEBIT
  CREDIT
}

enum CostCenterAllocationTarget {
  SALES
  COST_OF_GOODS_SOLD
}

/// أنماط ووحدات الإدخال المخصصة — ترقيم وثوابت وأعمدة لكل نوع مستند.
model DocumentProfile {
  id                  String           @id @default(uuid())
  companyId           String
  slug                String
  nameAr              String
  nameEn              String?
  baseType            DocumentBaseType
  prefix              String?
  nextNumber          Int              @default(1)
  defaultWarehouseId  String?
  lockWarehouse       Boolean          @default(false)
  defaultTreasuryId   String?
  lockTreasury        Boolean          @default(false)
  defaultCostCenterId String?
  lockCostCenter      Boolean          @default(false)
  visibleColumns      Json             @default("[]")
  showInSidebar       Boolean          @default(false)
  isActive            Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  company          Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  defaultWarehouse Warehouse?   @relation("DocumentProfileWarehouse", fields: [defaultWarehouseId], references: [id], onDelete: SetNull)
  defaultTreasury  Safe?        @relation("DocumentProfileTreasury", fields: [defaultTreasuryId], references: [id], onDelete: SetNull)
  defaultCostCenter CostCenter? @relation(fields: [defaultCostCenterId], references: [id], onDelete: SetNull)
  invoices         Invoice[]    @relation("InvoiceDocumentProfile")

  @@unique([companyId, slug])
  @@index([companyId, baseType])
  @@index([companyId, showInSidebar, isActive])
  @@index([defaultWarehouseId])
  @@index([defaultTreasuryId])
  @@index([defaultCostCenterId])
  @@map("document_profiles")
}

/// Per-company, per-document-type transaction policy (numbering, posting, pricing, taxes).
model TransactionSettings {
  id        String           @id @default(uuid())
  companyId String
  documentType DocumentBaseType @default(SALES_INVOICE)

  numberingMode NumberingMode @default(AUTOMATIC)
  sequenceMode  SequenceMode  @default(CONTINUOUS)

  autoPostOnSave      Boolean @default(false)
  autoPrintOnSave     Boolean @default(false)
  generateEntryOnSave Boolean @default(true)
  affectStock         Boolean @default(true)

  allowItemPriceOverride Boolean @default(true)
  preventSellingBelowCost Boolean @default(true)
  preventNegativeStock    Boolean @default(true)

  autoApplyVat             Boolean @default(true)
  autoApplyWht             Boolean @default(false)
  autoApplyDevelopmentTax  Boolean @default(false)
  cascadingDiscounts       Boolean @default(false)

  showAllAccountsInCustomerField Boolean @default(false)

  defaultSalesAccountId String?
  defaultSalesAccount   Account? @relation("SettingsSalesAccount", fields: [defaultSalesAccountId], references: [id])

  defaultPurchaseReturnAccountId String?
  defaultPurchaseReturnAccount   Account? @relation("SettingsPurchaseReturnAccount", fields: [defaultPurchaseReturnAccountId], references: [id])

  defaultCashAccountId String?
  defaultCashAccount   Account? @relation("SettingsCashAccount", fields: [defaultCashAccountId], references: [id])

  defaultBankGlAccountId String?
  defaultBankGlAccount   Account? @relation("SettingsBankGlAccount", fields: [defaultBankGlAccountId], references: [id])

  defaultOffsetAccountId String?
  defaultOffsetAccount   Account? @relation("SettingsOffsetAccount", fields: [defaultOffsetAccountId], references: [id])

  defaultChargesAccountId String?
  defaultChargesAccount   Account? @relation("SettingsChargesAccount", fields: [defaultChargesAccountId], references: [id])

  defaultCostCenterId String?
  defaultCostCenter   CostCenter? @relation(fields: [defaultCostCenterId], references: [id])

  defaultWarehouseId String?
  defaultWarehouse   Warehouse? @relation(fields: [defaultWarehouseId], references: [id])

  pricingPolicy              PricingPolicy              @default(LAST_SALE)
  costCenterSide             CostCenterPostingSide      @default(DEBIT)
  costCenterAllocationTarget CostCenterAllocationTarget @default(SALES)

  /// السماح بمردود حر دون فاتورة أصلية (مبيعات أو مشتريات حسب documentType)
  allowStandaloneReturns Boolean @default(true)
  /// إلزام الرد بنفس سعر الفاتورة الأصلية
  enforceOriginalPrice   Boolean @default(true)
  /// إظهار أعمدة العملة وسعر الصرف افتراضياً — يمكن تجاوزه من الخيارات الإضافية للحركة
  showFxColumns          Boolean @default(true)
  /// بعد تحميل أمر/مستند من القسم والرقم: السماح بتعديل الخانات أو قفلها
  allowEditLoadedOrder   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, documentType])
  @@index([defaultSalesAccountId])
  @@index([defaultPurchaseReturnAccountId])
  @@index([defaultCashAccountId])
  @@index([defaultBankGlAccountId])
  @@index([defaultOffsetAccountId])
  @@index([defaultChargesAccountId])
  @@index([defaultCostCenterId])
  @@index([defaultWarehouseId])
  @@map("transaction_settings")
}

// Invoice Lines
model InvoiceLine {
  id                      String    @id @default(uuid())
  invoiceId               String
  itemId                  String
  unitId                  String
  quantity                Decimal   @db.Decimal(18, 4)
  baseQuantity            Decimal   @db.Decimal(18, 4)
  /// الوحدة الأساسية للصنف وقت الحركة (قد تختلف عن unitId).
  baseUnitId              String?
  /// معامل التحويل المسجّل وقت الحركة (ثابت من بطاقة الصنف أو محسوب يدوياً).
  conversionFactor        Decimal?  @db.Decimal(18, 6)
  price                   Decimal   @db.Decimal(18, 4)
  total                   Decimal   @db.Decimal(18, 4)
  discountPercent         Decimal?  @db.Decimal(5, 2)
  discountAmount          Decimal?  @db.Decimal(18, 4)
  taxPercent              Decimal?  @db.Decimal(5, 2)
  taxAmount               Decimal?  @db.Decimal(18, 4)
  lineOrder               Int
  /// C5/Phase2 — unit cost actually charged to COGS/inventory when this line
  /// posted (SALE issue cost, or PURCHASE_RETURN's relieved cost). Captured
  /// at post time so returns/reversals can reference the true original cost
  /// instead of re-deriving whatever the average cost happens to be later.
  unitCostAtIssue         Decimal?  @db.Decimal(18, 4)
  /// H10 fix: links a SALE_RETURN/PURCHASE_RETURN line back to the original
  /// sold/purchased line it reverses, so over-return can be enforced server-side
  /// instead of relying on free-text description references.
  originalInvoiceLineId   String?
  /// M7 fix: this line's proportional share of the invoice's header discount
  /// (reporting only — does not feed back into this line's own discountAmount
  /// or tax, which stay validated against discountPercent/taxPercent alone).
  headerDiscountAllocated Decimal?  @db.Decimal(18, 4)
  /// Sales Invoice Enterprise Redesign: lot/traceability + line-note fields
  /// the frontend line grid already collected (`salesInvoiceLineSchema`) but
  /// which had no matching column here — silently dropped before reaching
  /// the API. Purely descriptive: they do not feed GL posting or costing.
  batchNumber             String?
  expiryDate              DateTime?
  productionDate          DateTime?
  serialNumbers           String?   @db.Text
  lineNotes               String?   @db.Text
  taxExemptionReason      String?
  /// Per-line issue/receipt warehouse. Falls back to Invoice.warehouseId when null.
  warehouseId             String?
  costCenterId            String?
  withholdingTaxRate      Decimal?  @default(0) @db.Decimal(8, 4)
  withholdingTaxAmount    Decimal?  @default(0) @db.Decimal(18, 4)
  batchAllocations        Json?
  color                   String?
  size                    String?
  customRevenueAccountId  String?

  invoice                   Invoice                    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item                      Item                       @relation(fields: [itemId], references: [id])
  unit                      Unit                       @relation(fields: [unitId], references: [id])
  baseUnit                  Unit?                      @relation("InvoiceLineBaseUnit", fields: [baseUnitId], references: [id])
  warehouse                 Warehouse?                 @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  costCenter                CostCenter?                @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  customRevenueAccount      Account?                   @relation("InvoiceLineRevenueAccount", fields: [customRevenueAccountId], references: [id], onDelete: SetNull)
  landedCostAllocationLines LandedCostAllocationLine[]
  originalInvoiceLine       InvoiceLine?               @relation("InvoiceLineReturns", fields: [originalInvoiceLineId], references: [id], onDelete: SetNull)
  returnLines               InvoiceLine[]              @relation("InvoiceLineReturns")

  @@index([invoiceId])
  @@index([itemId])
  @@index([invoiceId, itemId])
  @@index([originalInvoiceLineId])
  @@index([warehouseId])
  @@index([baseUnitId])
  @@index([costCenterId])
  @@index([customRevenueAccountId])
  @@map("invoice_lines")
}

// Invoice Conditions
model InvoiceCondition {
  id        String   @id @default(uuid())
  invoiceId String
  condition String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_conditions")
}

