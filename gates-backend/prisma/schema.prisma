  companyId          String
  code               String // Account code
  arabicName         String
  englishName        String?
  accountType        String? // نوع الحساب
  parentId           String? // Parent account
  accountSide        String? // مدين/دائن (legacy caption)
  accountNature      AccountNature   @default(DEBIT)
  /// HEADER = رئيسي / رئيسي فرعي (يُفرَّع منه فقط). POSTING = حساب حركة.
  accountKind        AccountKind     @default(POSTING)
  statementType      StatementType   @default(BALANCE_SHEET)
  costCenterRequired String? // إجباري/اختياري/بدون (legacy caption)
  requiresCostCenter Boolean         @default(false)
  defaultCostCenterId String?
  warning            String? // مدين/دائن/بدون
