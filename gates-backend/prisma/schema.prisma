}

/// سجل حركات إصدار ومد وتعديل وإفراج خطاب الضمان.
model LgActionHistory {
  id                  String       @id @default(uuid())
  companyId           String
  letterOfGuaranteeId String
  actionType          LgActionType
  actionDate          DateTime
  previousExpiryDate  DateTime?
  newExpiryDate       DateTime?
  previousAmount      Decimal?     @db.Decimal(18, 4)
  newAmount           Decimal?     @db.Decimal(18, 4)
  bankReferenceNo     String?
  notes               String?      @db.Text
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  company           Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  letterOfGuarantee ProjectLetterOfGuarantee @relation(fields: [letterOfGuaranteeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([letterOfGuaranteeId])
  @@index([actionType])
  @@index([actionDate])
  @@map("lg_action_histories")
}

// ============================================
// M12 — REAL ESTATE & UNIT MANAGEMENT (Wave 3)
// ============================================

model RealEstateSettings {
  id                                   String   @id @default(uuid())
  companyId                            String   @unique
  realEstateArAccountCode              String?  @db.VarChar(20)
  unearnedRealEstateRevenueAccountCode String?  @db.VarChar(20)
  realEstateRevenueAccountCode         String?  @db.VarChar(20)
  maintenanceDepositsAccountCode       String?  @db.VarChar(20)
  penaltyRevenueAccountCode            String?  @db.VarChar(20)
  createdAt                            DateTime @default(now())
  updatedAt                            DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("real_estate_settings")
}

/// @deprecated Prefer PropertyProject / PropertyPhase for new development work.
/// Kept so Wave 3 unit-sale posting (RealEstateUnit → UnitContract) stays live.
model RealEstateProject {
  id           String   @id @default(uuid())
  companyId    String
  projectCode  String
  projectName  String
  costCenterId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company    Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  costCenter CostCenter?          @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  buildings  RealEstateBuilding[]

  @@unique([companyId, projectCode])
  @@map("real_estate_projects")
}

model RealEstateBuilding {
  id           String   @id @default(uuid())
  projectId    String
  buildingCode String
  name         String
  totalFloors  Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project RealEstateProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  units   RealEstateUnit[]

  @@unique([projectId, buildingCode])
  @@map("real_estate_buildings")
}

model RealEstateUnit {
  id                 String   @id @default(uuid())
  buildingId         String
  unitCode           String
  /// RESIDENTIAL | COMMERCIAL | ADMINISTRATIVE
  unitType           String   @default("RESIDENTIAL") @db.VarChar(20)
  floor              Int      @default(0)
  grossArea          Decimal  @default(0) @db.Decimal(15, 2)
  netArea            Decimal  @default(0) @db.Decimal(15, 2)
  meterPrice         Decimal  @default(0) @db.Decimal(15, 2)
  totalPrice         Decimal  @default(0) @db.Decimal(15, 2)
  maintenanceDeposit Decimal  @default(0) @db.Decimal(15, 2)
  /// AVAILABLE | RESERVED | SOLD | DELIVERED
  status             String   @default("AVAILABLE") @db.VarChar(20)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  building     RealEstateBuilding      @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  contracts    UnitContract[]
  reservations RealEstateReservation[]
  propertyUnit PropertyUnit?

  @@unique([buildingId, unitCode])
  @@index([buildingId, status])
  @@map("real_estate_units")
}

model RealEstateReservation {
  id                 String    @id @default(uuid())
  companyId          String
  unitId             String
  customerId         String
  reservationDate    DateTime
  reservationAmount  Decimal?  @db.Decimal(15, 2)
  notes              String?   @db.Text
  expiryDate         DateTime?
  /// PENDING | CONFIRMED | CANCELLED | EXPIRED
  status             String    @default("PENDING") @db.VarChar(20)
  confirmedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  unit     RealEstateUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@index([unitId])
  @@index([customerId])
  @@map("real_estate_reservations")
}

enum PropertyUnitType {
  RESIDENTIAL_APARTMENT
  VILLA
  COMMERCIAL_RETAIL
  OFFICE_ADMIN
}

enum PropertyUnitStatus {
  AVAILABLE
  RESERVED
  CONTRACTED
  DELIVERED
  BLOCKED
}

enum UnitPaymentPlanType {
  EQUAL_INSTALLMENTS
  FRONT_LOADED
  CUSTOM_BALLOON
}

enum UnitInstallmentType {
  RESERVATION_DEPOSIT
  CONTRACTING_DOWNPAYMENT
  REGULAR_INSTALLMENT
  DELIVERY_PAYMENT
  MAINTENANCE_DEPOSIT
  ANNUAL_BALLOON
}

enum PostDatedChequeStatus {
  UNDER_SAFE_CUSTODY
  DEPOSITED_UNDER_COLLECTION
  CLEARED_COLLECTED
  BOUNCED_RETURNED
  REPLACED_CANCELLED
}

enum UnitResaleClearanceStatus {
  PENDING_CLEARANCE
  FINANCIALLY_CLEARED
  REJECTED
}

enum UnitRefundStatus {
  HELD_UNTIL_RESALE
  PARTIALLY_REFUNDED
  FULLY_REFUNDED
}

model PropertyProject {
  id                        String   @id @default(uuid())
  companyId                 String
  projectCode               String
  nameAr                    String
  nameEn                    String?
  location                  String?  @db.Text
  constructionCompletionPct Decimal  @default(0) @db.Decimal(8, 4)
  activePriceMultiplier     Decimal  @default(1) @db.Decimal(8, 6)
  costCenterId              String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  costCenter CostCenter?     @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  phases     PropertyPhase[]

  @@unique([companyId, projectCode])
  @@index([companyId])
  @@map("property_projects")
}

model PropertyPhase {
  id                        String   @id @default(uuid())
  projectId                 String
  phaseCode                 String
  nameAr                    String
  nameEn                    String?
  location                  String?
  constructionCompletionPct Decimal  @default(0) @db.Decimal(8, 4)
  activePriceMultiplier     Decimal  @default(1) @db.Decimal(8, 6)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  project PropertyProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  units   PropertyUnit[]

  @@unique([projectId, phaseCode])
  @@index([projectId])
  @@map("property_phases")
}

model PropertyUnit {
  id                       String             @id @default(uuid())
  phaseId                  String
  unitCode                 String
  unitType                 PropertyUnitType   @default(RESIDENTIAL_APARTMENT)
  grossArea                Decimal            @db.Decimal(18, 4)
  netArea                  Decimal            @db.Decimal(18, 4)
  floorNumber              Int                @default(0)
  basePricePerMeter        Decimal            @db.Decimal(18, 4)
  premiumModifiersTotal    Decimal            @default(0) @db.Decimal(18, 4)
  totalPrice               Decimal            @db.Decimal(18, 4)
  maintenanceDepositAmount Decimal            @default(0) @db.Decimal(18, 4)
  status                   PropertyUnitStatus @default(AVAILABLE)
  /// Optional bridge onto the Wave 3 inventory unit used by live sale posting.
  legacyRealEstateUnitId   String?            @unique
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  phase                PropertyPhase         @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  legacyRealEstateUnit RealEstateUnit?       @relation(fields: [legacyRealEstateUnitId], references: [id], onDelete: SetNull)
  contracts            UnitContract[]
  rentalAgreements     RentalPoolAgreement[]
  documentAttachments  DocumentAttachment[]

  @@unique([phaseId, unitCode])
  @@index([phaseId, status])
  @@index([status])
  @@map("property_units")
}

model UnitContract {
  id                     String              @id @default(uuid())
  companyId              String
  unitId                 String
  propertyUnitId         String?
  /// Buyer — kept as customerId so Wave 3 unit-sale posting does not break.
  customerId             String
  contractNumber         String
  contractDate           DateTime
  deliveryDate           DateTime?
  totalContractAmount    Decimal             @db.Decimal(15, 2)
  totalSellingPrice      Decimal             @default(0) @db.Decimal(18, 4)
  downPayment            Decimal             @default(0) @db.Decimal(15, 2)
  maintenanceAmount      Decimal             @default(0) @db.Decimal(15, 2)
  maintenanceDeposit     Decimal             @default(0) @db.Decimal(18, 4)
  discountAmount         Decimal             @default(0) @db.Decimal(15, 2)
  financingInterest      Decimal             @default(0) @db.Decimal(15, 2)
  outstandingArBalance   Decimal             @default(0) @db.Decimal(15, 2)
  unearnedRevenueBalance Decimal             @default(0) @db.Decimal(15, 2)
  paymentPlanType        UnitPaymentPlanType @default(EQUAL_INSTALLMENTS)
  /// ACTIVE | RESALE_IN_PROGRESS | TRANSFERRED | TERMINATED | TERMINATED_FORFEITED | COMPLETED
  status                 String              @default("ACTIVE") @db.VarChar(32)
  resaleLock             Boolean             @default(false)
  contractJournalEntryId String?
  handoverJournalEntryId String?
  postedAt               DateTime?
  handoverAt             DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  company                 Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  unit                    RealEstateUnit               @relation(fields: [unitId], references: [id], onDelete: Restrict)
  propertyUnit            PropertyUnit?                @relation(fields: [propertyUnitId], references: [id], onDelete: SetNull)
  customer                Customer                     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  installments            UnitInstallment[]
  postDatedCheques        PostDatedCheque[]
  resaleTransfers         UnitResaleTransfer[]
  cancellationSettlements UnitCancellationSettlement[]
  rentalAgreements        RentalPoolAgreement[]
  documentAttachments     DocumentAttachment[]

  @@unique([companyId, contractNumber])
  @@index([unitId])
  @@index([propertyUnitId])
  @@index([customerId])
  @@index([status])
  @@map("unit_contracts")
}

model UnitInstallment {
  id                   String              @id @default(uuid())
  contractId           String
  installmentType      UnitInstallmentType @default(REGULAR_INSTALLMENT)
  installmentNumber    Int
  dueDate              DateTime
  amount               Decimal             @db.Decimal(15, 2)
  originalAmount       Decimal             @default(0) @db.Decimal(18, 4)
  paidAmount           Decimal             @default(0) @db.Decimal(18, 4)
  balance              Decimal             @default(0) @db.Decimal(18, 4)
  dailyLateFeeRate     Decimal             @default(0.0005) @db.Decimal(8, 6)
  accumulatedLateFee   Decimal             @default(0) @db.Decimal(18, 4)
  interestPortion      Decimal             @default(0) @db.Decimal(15, 2)
  /// PENDING | UNPAID | PARTIALLY_PAID | PAID | OVERDUE | RESCHEDULED | CANCELLED
  status               String              @default("PENDING") @db.VarChar(20)
  chequeId             String?
  paymentTransactionId String?
  paidAt               DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  contract           UnitContract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  cheque             Cheque?           @relation(fields: [chequeId], references: [id], onDelete: SetNull)
  paymentTransaction CashTransaction?  @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)
  postDatedCheques   PostDatedCheque[]

  @@unique([contractId, installmentNumber])
  @@index([contractId, status])
  @@index([dueDate])
  @@index([status])
  @@map("unit_installments")
}

