# Environment Configuration
# Copy this file to .env and update with your actual values

# Node Environment
NODE_ENV=development

# Server Port
PORT=3001

# API rate limit (requests per 15 min per IP). Default: 5000.
# API_RATE_LIMIT_MAX=5000
# AUTH_RATE_LIMIT_MAX=30
# AUTH_REFRESH_RATE_LIMIT_MAX=60

# API authentication mode
#   enforce   → every /api/v1 request requires a valid JWT (forced when NODE_ENV=production,
#               and now also the default everywhere else if this var is unset/blank — H21 fix)
#   anonymous → LOCAL-DEV-ONLY open mode (synthetic admin + first active company); never set
#               this on any shared/staging box, since it serves the whole API unauthenticated
# Startup fails if NODE_ENV=production and API_AUTH_MODE=anonymous.
API_AUTH_MODE=enforce

# Database Configuration (MySQL)
# Recommended pool params for concurrent API traffic (see docs/MYSQL_CONNECTION_POOLING.md):
# DATABASE_URL="mysql://root:password@localhost:3306/gates_db?connection_limit=20&pool_timeout=10&connect_timeout=10"
# MySQL pool tuning (Prisma): connection_limit caps pool size; pool_timeout waits for a free connection (seconds).
# Keep connection_limit at 20 in production — infra/mysql/my.cnf sets max_connections=80 for API + workers + admin.
# For lower TCP handshake churn, keep the API process warm and reuse this URL across restarts.
DATABASE_URL="mysql://root:password@localhost:3306/gates_db"

# Optional: Replica Database URL (for read replicas)
# REPLICA_DATABASE_URL="mysql://user:password@localhost:3306/gates_db_replica"

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Keycloak Configuration (if using Keycloak for authentication)
KEYCLOAK_ENABLED=false
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=your-realm
KEYCLOAK_CLIENT_ID=your-client-id
KEYCLOAK_CLIENT_SECRET=your-client-secret

# Local password login (only when KEYCLOAK_ENABLED=false): POST /api/v1/auth/login
# Must match gates-web NEXT_PUBLIC_AUTH_LOGIN_PATH=/auth/login and a user row with passwordHash in DB.
JWT_DEV_SECRET=change-me-to-a-long-random-secret-16chars-min

# Required in production (tenant backup / field encryption). 32+ random characters.
# ENCRYPTION_KEY=

# Railway preview: allow *.up.railway.app until FRONTEND_URL is the real web origin.
# CORS_ALLOW_RAILWAY=true

# Optional extra browser origins (comma-separated)
# CORS_ORIGINS=

# Local fixtures only. Production deploy must not seed.
# SEED_ON_BOOT=false
# ALLOW_PROD_SEED=false
# SEED_OWNER_PASSWORD=

# Optional UUID of company for POST /auth/register (defaults to first active company or seed company)
# DEFAULT_REGISTRATION_COMPANY_ID=00000000-0000-0000-0000-000000000001

# ── Outbound email (L4) ────────────────────────────────────────────────────
# Optional: leave SMTP_HOST blank to disable email sending (report-delivery jobs
# will log and skip instead of sending, rather than failing).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Redis Configuration (if using Redis for caching/queues)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# MQTT Configuration (if using MQTT for real-time updates)
MQTT_ENABLED=false
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Tax Authority Integration (if applicable)
TAX_PRIVATE_KEY=
TAX_PUBLIC_KEY=
TAX_AUTHORITY_URL=

# ── ETA e-invoicing (M14) ─────────────────────────────────────────────────────
# false → MockEtaClient (development). true → live client (requires signing config below).
# Set ETA_SIGNING_ENABLED=true in production to require valid PKCS#11 / ePass config; when false, submissions are tagged MOCK_SIGNED_DEV.
ETA_SIGNING_ENABLED=false
# Production: set ETA_USE_LIVE_CLIENT=true and ETA_SIGNING_PROVIDER=pkcs11 (or your live provider). mock is dev-only.
ETA_USE_LIVE_CLIENT=false
ETA_API_BASE_URL=
ETA_IDENTITY_URL=
ETA_CLIENT_ID=
ETA_CLIENT_SECRET=
# Signing provider: mock | pkcs11
ETA_SIGNING_PROVIDER=mock
# PKCS#11 hardware token (only when ETA_SIGNING_PROVIDER=pkcs11)
ETA_PKCS11_MODULE_PATH=
ETA_PKCS11_SLOT=0
ETA_PKCS11_CERT_LABEL=
ETA_PKCS11_PIN=
ETA_TOKEN_PIN=

# ── Document archive storage (M20) ────────────────────────────────────────────
# local | s3
ARCHIVE_STORAGE_PROVIDER=local
ARCHIVE_LOCAL_ROOT=./storage/archive
# S3 / S3-compatible (MinIO, Cloudflare R2) when ARCHIVE_STORAGE_PROVIDER=s3|minio|r2
ARCHIVE_S3_BUCKET=
ARCHIVE_S3_REGION=
ARCHIVE_S3_ENDPOINT=
ARCHIVE_S3_ACCESS_KEY_ID=
ARCHIVE_S3_SECRET_ACCESS_KEY=
ARCHIVE_S3_FORCE_PATH_STYLE=false

# ── Legacy ETL (Phase 3) ──────────────────────────────────────────────────────
# JSON fixture directory, or set LEGACY_MSSQL_* to read from SQL Server directly.
LEGACY_DATA_PATH=./scripts/migration/fixtures/sample
LEGACY_MSSQL_SERVER=
LEGACY_MSSQL_DATABASE=
LEGACY_MSSQL_USER=
LEGACY_MSSQL_PASSWORD=
LEGACY_MSSQL_PORT=1433
LEGACY_MSSQL_ENCRYPT=false

# ── Gates AI (Phase 1) ────────────────────────────────────────────────────────
# Optional. When unset, /api/v1/ai/health reports configured=false and chat
# endpoints return 503. Never commit a real key.
OPENAI_API_KEY=
# Defaults to gpt-4o-mini when blank.
OPENAI_MODEL=gpt-4o-mini
# OpenAI-compatible base (no trailing slash). Defaults to https://api.openai.com/v1
OPENAI_BASE_URL=
# Optional PostgreSQL + pgvector sidecar for Gates AI RAG (do not point at MySQL).
# When unset, embeddings are stored as JSON on MySQL and ranked in-process.
# VECTOR_DATABASE_URL=postgresql://gates:gates@localhost:5432/gates_vectors
