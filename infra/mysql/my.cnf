# Gates ERP — MySQL 8.0.30+ production profile
# Target host: dedicated (or reserved) 8 GiB RAM / 4+ CPU cores.
# Buffer pool is 6G (~75% is too high; 6G is 75% of 8G raw but leaves
# ~2G for OS, connections, tmp tables, and InnoDB redo). Use 60–70% of
# *MySQL-available* RAM if the box also runs Node/Redis (see my.dev.cnf).
#
# Apply:
#   Linux:   /etc/mysql/conf.d/gates.cnf  then  systemctl restart mysql
#   Docker:  mount this file at /etc/mysql/conf.d/gates.cnf
# Changing innodb_buffer_pool_size / innodb_redo_log_capacity requires a restart.
#
# Verify after restart:
#   SHOW VARIABLES WHERE Variable_name IN (
#     'innodb_buffer_pool_size','innodb_buffer_pool_instances',
#     'innodb_redo_log_capacity','innodb_log_buffer_size',
#     'innodb_flush_log_at_trx_commit','max_connections',
#     'tmp_table_size','max_heap_table_size'
#   );
#   SHOW ENGINE INNODB STATUS\G   -- look for buffer pool hit rate

[mysqld]
# ---------------------------------------------------------------------------
# InnoDB memory — keep hot indexes and working set in RAM
# ---------------------------------------------------------------------------
# 6G on an 8G machine (60–70% of host RAM). Must be a multiple of
# innodb_buffer_pool_chunk_size (128M) × innodb_buffer_pool_instances.
innodb_buffer_pool_size = 6G
# Split the pool to cut buffer-pool mutex contention (RAM > 2G).
# 4 instances matches the requested default; raise toward core count
# only if the host is larger than 8G and you see buffer-pool waits.
innodb_buffer_pool_instances = 4

# Bypass the OS page cache so InnoDB owns the hot pages (avoids double buffering).
# Linux / Docker only — do not set this on macOS Homebrew or mysqld may fail to start.
innodb_flush_method = O_DIRECT

# ---------------------------------------------------------------------------
# Redo / transaction log — batch journal posts and bulk UPSERTs
# ---------------------------------------------------------------------------
# MySQL 8.0.30+ replaces innodb_log_file_size. 1G covers multi-line
# journal batches and invoice-line UPSERTs without frequent log switches.
innodb_redo_log_capacity = 1G
# Pre-8.0.30 equivalent (do not set both):
# innodb_log_file_size = 512M
# innodb_log_files_in_group = 2

# Hold redo in memory during heavy bulk writes before flushing to the log file.
innodb_log_buffer_size = 32M

# Strict ACID for an accounting ledger (fsync redo on every COMMIT).
# Set to 2 only on battery-backed / crash-safe storage when you accept
# losing ~1s of committed transactions after a host power loss.
innodb_flush_log_at_trx_commit = 1
# innodb_flush_log_at_trx_commit = 2

# SSD starting point; raise if iostat shows the disk is idle under load.
innodb_io_capacity = 1000
innodb_io_capacity_max = 2000

# ---------------------------------------------------------------------------
# Connections — sized to the Node/Prisma pool, not an arbitrary 1000
# ---------------------------------------------------------------------------
# Prisma defaults (src/shared/database/prisma.ts):
#   production API process  = 20
#   production worker process = 20  (npm run start:workers)
#   prismaRead fallback on the same URL ≈ another 20 if no replica
#   admin / mysqldump / migrations / monitoring ≈ 15
# Total ceiling 80. Do not raise without adding RAM for per-thread buffers.
max_connections = 80
thread_cache_size = 16

# ---------------------------------------------------------------------------
# Memory temp tables — keep report aggregations off disk
# ---------------------------------------------------------------------------
# Both must match; MySQL uses the lower of the two for in-memory temps.
tmp_table_size = 64M
max_heap_table_size = 64M

# ---------------------------------------------------------------------------
# Character set (Prisma / utf8mb4)
# ---------------------------------------------------------------------------
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
}
