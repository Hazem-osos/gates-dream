# Copy to `.env` or `.env.local` and adjust. Next.js reads these at build/dev time.
# https://nextjs.org/docs/app/building-your-application/configuring/environment-variables

# API base (no trailing slash). Omit this to use same-origin `/api/v1`
# (Next rewrites to BACKEND_PROXY_TARGET — avoids CORS / "Failed to fetch").
# On Railway, leave this unset and set BACKEND_PROXY_TARGET at build time.
# NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Where Next should proxy `/api/v1` and `/health` (server only, not sent to the browser).
# Railway: http://${{gates-backend.RAILWAY_PRIVATE_DOMAIN}}:${{gates-backend.PORT}}
# BACKEND_PROXY_TARGET=http://127.0.0.1:3001

# SSR / server-side fetches when not using NEXT_PUBLIC_API_URL (optional; default 127.0.0.1:3001).
# BACKEND_INTERNAL_URL=http://127.0.0.1:3001

# Auth routes under that base (see gates-backend auth routes).
NEXT_PUBLIC_AUTH_LOGIN_PATH=/auth/login
NEXT_PUBLIC_AUTH_REGISTER_PATH=/auth/register

# Route gating — mirror the backend API_AUTH_MODE.
#   enforce   → unauthenticated routes redirect to /login, 401 bounces to /login
#   anonymous → no gating (development only)
# Defaults to enforce when NODE_ENV=production, anonymous otherwise.
# Use enforce on Railway / any shared box.
NEXT_PUBLIC_AUTH_MODE=anonymous

# After login/register success (when no safe `?from=`). Default in code is `/dashboard`.
# NEXT_PUBLIC_POST_AUTH_REDIRECT=/dashboard

# Optional: set ANALYZE=true when running bundle analysis (see package.json).
# ANALYZE=true
