{
  "name": "gates-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "railway:start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --quiet \"app/accounting/**/*.{ts,tsx}\" \"app/inventory/**/*.{ts,tsx}\" \"app/extracts/**/*.{ts,tsx}\" \"app/contracting/**/*.{ts,tsx}\" && eslint --quiet \"lib/**/*.{ts,tsx}\" \"components/report/**/*.{ts,tsx}\" \"components/GlobalApiErrorToast.tsx\"",
    "audit:client-storage": "node scripts/audit-client-storage.mjs",
    "audit:integration": "node scripts/inject-backend-reachability.mjs --dry-run",
    "reports:inventory": "node scripts/generate-report-inventory.mjs",
    "reports:catalog": "node scripts/generate-report-catalog-ts.mjs",
    "reports:titles": "node scripts/backfill-report-title-ar.mjs && npm run reports:catalog",
    "reports:clean-legacy": "node scripts/clean-legacy-report-filter-chrome.mjs && npm run reports:audit:strict",
    "reports:rewrite-filters": "node scripts/rewrite-inventory-report-filters.mjs && node scripts/rewrite-non-inventory-report-filters.mjs",
    "reports:previews:bulk": "node scripts/bulk-catalog-previews.mjs",
    "reports:audit": "node scripts/report-ui-audit.mjs",
    "reports:audit:strict": "node scripts/report-ui-audit.mjs --strict",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.90.10",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/react-datepicker": "^6.2.0",
    "autoprefixer": "^10.6.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "driver.js": "^1.8.0",
    "framer-motion": "^13.2.0",
    "gsap": "^3.15.0",
    "jsbarcode": "^3.12.3",
    "lenis": "^1.3.26",
    "lucide-react": "^0.503.0",
    "minisearch": "^7.2.0",
    "next": "15.3.8",
    "postcss": "^8.5.28",
    "primeicons": "^7.0.0",
    "primereact": "^10.9.5",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-datepicker": "^8.3.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.72.1",
    "react-icons": "^5.5.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.15"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9",
    "eslint-config-next": "^15.3.8"
  }
}
